---
import '../styles/home.css';
import Layout from '../layouts/Layout.astro';
import SearchEntry from '../components/SearchEntry.astro';
import { allNotes, allThings } from '../lib/personal.js';
import { fmtDate, inlineMd } from '../lib/markdown.js';
import { intrinsicProps } from '../lib/image-dims.js';
/* 首屏那两张照片上的 `width`/`height` 由构建期读真文件头发来（`src/lib/image-dims.js`），两句口径写在这里而不是
   模板里——Astro 把 HTML 注释**原样落进产物**（`src/layouts/Layout.astro:21` 那格为同一件事点过名），
   说明写进模板就等于把它发给每一位访客，还会被 `tools/imgpipe-check.mjs` 数成一枚图注。
   ① **这两枚不参与最终盒尺寸**：`home.css:89` 那条 `.bg-photo img{ position:absolute; inset:0; width:100%; height:100% }`
      把它们完全覆写 ⇒ 布局一个像素不动（改前／改后逐枚 rect 与整页 scrollHeight 实测相同，读数登记在规范 §8.4）。
      发它们只为了一条判据能全站成立："产物里每一枚 img 都自带固有盒子"，不留"哪几枚可以不带"的例外名单。
   ② **这里不加 `decoding="async"`**：这两张是 eager 载入，那一枚属性会把解码挪出主线程，而 §8.2 那条时间轴
      （照片 1.2s 起、2.2s 走完、3.4s 收口）是按现在的解码时机签的字——要动它得连那串数一起复量，不在这一卡的格子里。 */
import { visiblePosts } from '../lib/posts.js';
import { readMinutes, tone } from '../lib/stats.js';

const pad = n => String(n).padStart(2, '0');
/* 只准走 visiblePosts()：草稿不进首页那三篇、也不进 .hero-log 那个数（一处 filter＝六处同一个口径）。
   顺序由 lib 给：置顶在最前，其余按日期倒序——首页那三篇吃的就是这个数组的前三个。 */
const posts = await visiblePosts();
/* 手记与小东西各取一次，顺序住在 `src/lib/personal.js`（首页、`/notes/`、`/things/`、关于页吃同一枚答案）。
   `.hero-log` 那三个数从这里来：`00 things`／`00 notes` 与页面上真的有几枚是同一把尺子量出来的，
   不是手写的一行字——数字与内容不同源那天，它就是关于页那一格禁的"拿不到的数字"（§13）。 */
const notes = await allNotes();
const things = await allThings();
const counts = { essays: posts.length, things: things.length, notes: notes.length };
/* 首页下半段只是"最近三篇"，不是第二个 /essays/：超过三条就把尾巴剪掉，宁缺不挤 */
const recent = posts.slice(0, 3);
/* 收尾那一句是最新一条手记；零枚手记时它是 `undefined`，下面那一块整块不画（不是退回一句假话）。 */
const walk = notes[0];
/* 「读最近一篇」那一枚主行动（二轮 §4.1，规范 §9）指的就是**目录的第一行**：上面那枚 `posts` 是
   `visiblePosts()` 排好的（置顶在最前、其余按日期倒序），`recent[0]` 与首页下面那三篇的第一篇、
   `/essays/` 第 1 页的第一行是同一枚值——同一把尺子（§15 分页容量 3）。
   ⚠️ 站内不许出现第二枚"最新一篇"的算法：另起一处 `sort((a,b)=>b.date-a.date)` 就是给哪一篇算最新
      立第二处真值（§16 派生字段铁律：值 = f(同一张表里的参数)，只许一个出处）。
   ⚠️ 今天三篇稿子的 `pinned` 全空（`src/content/posts/*.md` 逐篇 front matter 实测没有这一枚键）⇒
      此刻 `recent[0]` **也就是**日期最晚那篇；作者哪天置顶一枚，这一枚入口跟着走到置顶那篇，
      措辞的账登记在规范那一格，不由这行注释替它改口。
   ⚠️ 零 JS、构建期定死：href 在烘出来的 HTML 里就是一个地址，脚本一段都没有（`hero.js` / `site.js`
      一个字没动）。`posts` 为空（草稿全被滤光那天）时 `{newest && …}` 短路 ⇒ **整枚按钮一个字节都不落**，
      不许留一枚指 `/essays/undefined/` 的死锚点（§12 死锚点那一族）。
   ⚠️ 这一段说明走 frontmatter 注释、不走模板里的 HTML 注释：Astro 把后者原样落进每一页产物，而
      `tools/font-subset.mjs` 的码点并集读的正是**产物里的每一个字符**（`distUnion()`，`--check` 在
      `gate` 里排在 build 之后）——写进模板注释的新汉字会在门禁那一步报成"域外字"，代价是重切两枚子集。 */
const newest = recent[0];
---
<Layout title="mistwood · 晨雾森林" here="home">
  <div class="scene" aria-hidden="true">
    <div class="bg-gradient"></div>

    <!-- 两张同构图照片：亮 / 暗，主题切换 = 交叉淡化（两枚属性为什么加、为什么不上屏，写在上面 --- 里） -->
    <div class="bg-photo" data-depth="0.02">
      <img class="photo-light" src="/assets/bg-light.jpg" {...intrinsicProps('/assets/bg-light.jpg')} alt="" draggable="false">
      <img class="photo-dark" src="/assets/bg-dark.jpg" {...intrinsicProps('/assets/bg-dark.jpg')} alt="" draggable="false">
    </div>

    <div class="scrim"></div>
    <div class="lantern-rim"></div>
    <div class="lantern-glow"></div>

    <!-- 会动的雾 -->
    <div class="mist-band b1" data-depth="0.12"></div>
    <div class="mist-band b2" data-depth="0.12"></div>
    <div class="mist-band b3" data-depth="0.12"></div>

    <div id="fireflies"></div>
  </div>

  <main class="hero">
    <p class="hero-name">Alyssumira</p>
    <h1 class="hero-title">
      <span class="line"><span class="w" style="--i:0"><span>在森林</span></span><span class="w" style="--i:1"><span>与网络</span></span><span class="w" style="--i:2"><span>之间，</span></span></span>
      <span class="line"><span class="w" style="--i:3"><span>收集</span></span><span class="w" style="--i:4"><span>微风、</span></span><span class="w" style="--i:5"><span><em>light</em></span></span><span class="w" style="--i:6"><span>和</span></span><span class="w" style="--i:7"><span>文字。</span></span></span>
    </h1>
    {/* 首屏唯一的那枚可点面（二轮 §4.1 立项、规范 §2.6 于 2026-10-02 退成玻璃胶囊）：导航那副材质 + 墨字，
        指向目录第一行那一篇文章。材质、读数、悬停那一族、配额与打印的账都在 §2.6 与 `home.css` 的注释里；
        这一行不落 HTML 注释（上面 frontmatter 那段说清了为什么）。 */}
    {newest && <a class="hero-cta" href={`/essays/${newest.id}/`}>read — 读最近一篇</a>}
    <!-- 观察日志：数字 = 构建期真实条数。⚠️ 搜索入口挂在**这一行末尾**（裁决与账在 §11 的"导航"那一整格：
         胶囊里不加第三枚按钮 ⇒ 首页这一行就是它在这一屏的宿主）。这一行没有 `.page-head`，但它与子页
         扉页那一行是同一族（13px 等宽 + 宽字距 + 构建期真数），所以"同族的位置"落在这里；
         不新造一行——`.hero-log` 是 `white-space` 自然折行的，窄屏放不下时它自己换行，
         面板那一档跟着朝上开（base.css 里 `.hero-log .settings.search-panel` 那一条）。
         ⚠️ 这一行的 tag 从 `<p>` 换成了 `<div>`，是解析器的规矩不是口味：`<p>` 遇到块级元素会当场
         自我闭合，而入口那一块里装着面板那枚 `<div class="settings">`——挂着 `<p>` 的时候面板被甩到
         `.search` 外面，"点外面只收不抢焦点"于是把**点结果行**当成点了外面（选中一篇的瞬间面板先收、
         焦点没还），几何读数也一路落到 `top:100%+14` 即屏幕之外。版面逐位不变：
         `*{margin:0;padding:0}`（base.css:210）早就清了 `<p>` 的 UA 外边距，这一行的所有样式都挂在 class 上。
         ⚠️ **这一行末尾又多了一枚字：订阅入口**（第六轮 `card/navcrumb`，`docs/美化建议.md` §11.2 F1）。
         feed 本来就躺在 `<head>`（`Layout.astro:100` 那枚机器读的 `<link rel=alternate>`）与 404 的地址清单里，
         缺的只是"人看得见的那一枚"——一个有 RSS 却在正常浏览路径里订不了的博客，功能上是断的。四条落法：
         ① 形状跟着**同一行里那枚** `search — 搜全文` 走（拉丁标签 + 破折号 + 中文，§7 那一层的既有形状），
         锚点吃 `.tax-back` 那份声明——"住在标签行里的那一枚链接"正是它管的一族（§17 复用类、不复制声明，
         零新 CSS、零新垂直槽位，`gap-check` 那 142 枚一个不动）；
         ② 落点在这一行**不在导航**：§11 那笔"七项胶囊／296.48／上限 300"的账是搜索撞过的，第八项等于再撞一遍；
         ③ **只给 RSS 一枚**，Atom 不并列：两枚 feed 读的是同一个 `visiblePosts()`（`atom.xml.js:4` 那格钉着），
         并排两枚字给读者的不是两份内容，是同一份清单的两副地址——多那一枚只会让人多猜一次点哪个；
         ④ 它是真 `<a href="/rss.xml">`，**不靠脚本显形**（与 `SearchEntry` 那块带 `hidden` 的相反）：
         无 JS 的访客照样订得到，§12 那句"有字没功能"在这一格反过来站。
         代价照实登记：订阅入口今天只有首页这一处，子页扉页那一行（`.sec-label`）是 `white-space:nowrap`
         的门牌，加一枚字就得逐档量它顶不顶穿内容盒——那一笔归 §11 那把尺，本轮不为它重开。 -->
    <div class="hero-log"><b>{pad(counts.essays)}</b> essays<span class="sep">·</span><b>{pad(counts.things)}</b> things<span class="sep">·</span><b>{pad(counts.notes)}</b> notes<span class="sep">·</span><a class="tax-back" href="/rss.xml" title="订阅源（RSS 2.0）：站上架得出的文章都在，草稿一枚不进">rss — 订阅</a><SearchEntry /></div>
    <!-- 此刻的话：入夜＝守夜 / 清晨＝初 / 傍晚＝暮，由 site.js 决定说不说（读不到 session 就永远不说） -->
    <p class="hero-watch" id="hero-watch" hidden></p>
  </main>

  <!-- 首页下半段：日志报了"03 essays"，这里就是那三篇的名字——同一句话的数字层与实例层（§4）。
       上一轮撤掉 .ending 之后首页只剩一屏，§5 那条溶到 --bg-base 的斜坡没了职责；
       补回来的不是那块纯色，是它下面本来就该有的实色内容区。 -->
  <section class="home-lower">
    <h2 class="sec-label">recent essays — <b>{pad(recent.length)}</b> →</h2>
    <ol class="essay-index">
      {recent.map((p, i) => {
        const d = p.data.date;
        return (
          <li>
            <a class="row reveal" href={`/essays/${p.id}/`} data-slug={p.id}>
              <span class="folio">{pad(i + 1)}</span>
              <span class="row-main">
                <h3>{p.data.title}</h3>
                <p class="row-ex">{p.data.excerpt}</p>
              </span>
              <span class="row-side">
                <time>{fmtDate(d).slice(5)}</time>
                <span class="row-min">{readMinutes(p.body)} min</span>
              </span>
            </a>
          </li>
        );
      })}
    </ol>

    <!-- 最后一句交给 notes：这一页以作者真写过的一句话收尾，"再走回雾里"那一拍由它承担（§5）。
         句子走 inlineMd，和 /notes/ 上同一份文本同一个解析口径——两处两种渲染迟早会分叉。
         ⚠️ 零枚手记（`src/content/notes/` 空着——那一层的文件不进仓库，模板出厂就是这一档）时这一块
            **整块不出现**，不许留一行 `<time></time>` 的空壳（§14 那条"没填 ⇒ 不出现"，与首页
            「读最近一篇」那枚按钮同一条：`posts` 为空时它一个字节都不落）。 -->
    {walk && (
      <a class="home-note reveal" href="/notes/">
        <time>{fmtDate(walk.data.date)}</time>
        <p class={tone(walk.body)} set:html={inlineMd(walk.body.trim())}></p>
      </a>
    )}
  </section>
</Layout>

<script>
  import '../scripts/hero.js';
</script>
