---
import Layout from '../layouts/Layout.astro';
import SearchEntry from '../components/SearchEntry.astro';
import { siteFacts, tone } from '../lib/stats.js';
import { inlineMd } from '../lib/markdown.js';
import { intrinsicProps } from '../lib/image-dims.js';
/* 人像那两枚宽高原先是模板里手写的字面量 276/276（**值是对的，但是抄来的**）：换成构建期读真文件头。
   为什么这一枚值得动：`tools/imgpipe-check.mjs` 那把尺量的是"dist 里的属性 ⇄ 盘上真尺寸"，
   而抄来的字面量一旦哪天换了别的人像就会悄悄对不上——那正是判据要红的形状，可它红的是我们自己的记账，
   不是页面的病。换掉之后这一枚图没有"第二处真值"可漂。
   几何零影响：`mistwood.css:504` 给 `.portrait img` 写的是 `position:absolute; inset:0; width:100%; height:100%`，
   盒子由 `.portrait` 那枚 `width:220px; aspect-ratio:1/1`（:634）定，两枚属性从来不上屏（实测见规范 §8.4 那一格）。
   ⚠️ 说明写在 `---` 里而不是模板里：Astro 把 HTML 注释原样落进产物（`src/layouts/Layout.astro:21` 点过名）。 */
import { visiblePosts } from '../lib/posts.js';
import { fonts, notes, BIRTH_DATE, EMAIL } from '../data/site.js';
/* 一生格子（`card/lifegrid`）：吃 `src/lib/lifegrid.js` 那三枚纯函数——与 `tools/lifegrid-check.mjs`
   同一份实现（接法照 taxonomy.js：页面与门禁两处说了算的那种分叉，§16 记过）。 */
import { parseBirth, lifeField, lifeFieldHtml } from '../lib/lifegrid.js';

/* 邮箱那枚字面量原来就是这一行（`const EMAIL = 'mailto:…'`）——第十八轮 `card/reading2` 把它收进
   `src/data/site.js`（挨着 `AUTHOR`），因为详情页的"写信回应这一篇"也要吃它：两枚同一个地址、
   两处各写一遍，就是 §13a 点名的"抄的那份改了没人知道"那一族。这一页现在是消费者，不是真值所在地。 */
/* 站名与 GitHub 用户名是同一个字面量：这一行是全站唯一一处 github 地址（§13） */
const GITHUB = 'https://github.com/Alyssumira';
/* ⚠️ 站点档案那几个数（篇数 / 字数 / 通读分钟）必须和列表页同一把尺子——尺子就是 visiblePosts()：
   直接 getCollection('posts') 的话，一篇草稿会在关于页被数进去，而列表页搜不到它（stats.js 文件头那句
   "列表页与关于页必须是同一把尺子"讲的正是这一族；runtime-check 拿产物对这一笔账）。 */
const f = siteFacts(await visiblePosts());
const fontNames = fonts.map(x => x.name).join(' · ');

/* 一生格子（`card/lifegrid`）：两枚输入——出生日与构建日，别的都不参与。
   `f.now` 就是上面"构建于"那一行用的同一枚 `now`（§16 一页只许有一个构建时刻；取法见 src/lib/stats.js）。
   ⚠️ 今天 `BIRTH_DATE` 是空串（`src/data/site.js` 里那一枚**没有默认值**的字段）⇒ `born` 是 false
      ⇒ 这一片格子一格都不画，页面上只剩下面那句实话。不许退回"第 0 年"、也不许画一枚占位灰格
      （§12:1000 那条"载入次数读不到时整行不出现"是同一条口径）。
   ⚠️ 翻页／入场动效一格都不加（§1.2 一处动处处静）；这块也不进阅读区（§12「树影铺满子页」同族）。 */
const birth = parseBirth(BIRTH_DATE);
const life = birth ? lifeField(birth, f.now) : null;
const born = !!life && life.weeks > 0;

/* 仓库两头的日期同一天时不必写成一个区间——"2026.09.27 → 2026.09.27" 看起来像坏了 */
const tended = !f.tended ? ''
  : f.tended.first === f.tended.last
    ? `${f.commits} 次提交 · 最早的一次就在 ${f.tended.first}`
    : `${f.commits} 次提交 · ${f.tended.first} → ${f.tended.last}`;

/* 最近一次散步不在这行字里手写第二遍：它就是 notes 的最新一条 */
const walk = notes[0];
---
<Layout title="关于 · mistwood" desc="写代码的人，住在城市边缘，心在森林里。" here="about">
  <main class="wrap">
    <header class="page-head reveal">
      <h1 class="page-title">关于</h1>
      <!-- 这一页原本没有 `.sec-label` 那一行（扉页只有标题）。搜索入口要落在扉页那一族里（§9/§11），
           所以这里补的正是那一族的一行：`solo` 让分隔点不出现，`margin-top:16px` 吃的是
           `.page-head .sec-label` 那一条既有声明（mistwood.css:293），没有新造一行版面常数、
           也没有新增一枚垂直间距槽位（gap-check 的在册数因此不为它动）。
           tag 用 `<div>` 而不是 `<span>`：这一行现在要能承面板那枚块级元素，理由在 SearchEntry.astro 头上。 -->
      <div class="sec-label"><SearchEntry solo /></div>
    </header>

    <!-- 人像已到位（public/assets/portrait.png，276×276 透明角）；文案仍是这一页的作者口吻 -->
    <div class="about-inner">
      <!-- 桌面 ≥1024 这两块左右排（人像左、简介右）——简介只有两句，不是长阅读，
           所以它走"构图"的度量，不占 §4 那 680 的长文阅读度量；essays 的 680 一个字不动 -->
      <div class="about-lede">
        <div class="portrait reveal"><img src="/assets/portrait.png" alt="Alyssumira" {...intrinsicProps('/assets/portrait.png')}></div>
        <div class="about-text reveal">
          <p>写代码的人，住在城市边缘，心在森林里。白天修 bug，傍晚散步，夜里把这个网站当作营地慢慢打理。</p>
          <p>这里不追热点，只收集经得起重读的东西。</p>
        </div>
      </div>
      <!-- 整行是可点开的披露件：那一枚点只是记号，命中区是这一整行（§15）。
           展开的内容不新写——就是 notes 最近几条，"这一周在做什么"的答案本来就在日志本里 -->
      <details class="about-now reveal">
        <summary><span class="dot"></span>now · 在给这个网站种内容</summary>
        <ul class="now-list">
          {notes.slice(0, 3).map(n => (
            <li>
              <time>{n.date}{n.jieqi ? ' · ' + n.jieqi : ''}</time>
              <span class={tone(n.text)} set:html={inlineMd(n.text)}></span>
            </li>
          ))}
        </ul>
      </details>

      <div class="contact reveal">
        <nav class="contact-links">
          <!-- 地址来自 `src/data/site.js` 的 `EMAIL`（第十八轮 `card/reading2` 收编，全站唯一一处；
               详情页那一枚"写信回应"吃的是同一枚，两处不会各写一个邮箱）。
               空着 ⇒ 这一枚锚点整枚不出现（§14"没填 ⇒ 不出现"：`href=""` 是一枚点了停在原地的活壳）。 -->
          {EMAIL && <a href={EMAIL}>email</a>}
          <a href={GITHUB} target="_blank" rel="noopener noreferrer">github</a>
        </nav>
        <!-- 节气是手填位（§7）：空着就不显示。算出来的近似节气不配站在分钟级时钟旁边 -->
        <p class="last-walk">last walk · {walk.date} · weather: {walk.weather}{walk.jieqi ? ' · ' + walk.jieqi : ''}</p>
      </div>

      <!-- 站点档案：数字全部在构建期从仓库里数出来。没有"访问量"这一栏，因为本站没有服务端 ⇒ 拿不到 -->
      <section class="colophon reveal" aria-labelledby="colophon-title">
        <h2 class="col-title" id="colophon-title">站点档案 <span>colophon</span></h2>
        <dl class="col-grid">
          <div>
            <dt>文章</dt>
            <dd>{f.posts} 篇 · 约 {f.words} 字 · 通读 {f.minutes} 分钟</dd>
          </div>
          <div>
            <dt>构成</dt>
            <dd>{f.templates} 个页面模板 · {f.cssFiles} 份样式表（源码 {f.cssKb} KB）</dd>
          </div>
          <div>
            <dt>字体</dt>
            <dd>{fontNames}</dd>
          </div>
          {tended ? (
            <div>
              <dt>打理</dt>
              <dd>{tended}</dd>
            </div>
          ) : null}
          <div>
            <dt>构建于</dt>
            <dd>{f.built}</dd>
          </div>
          <!-- 这一行是那一块格子的**读数行**，也是它今天的空态（两种都由同一次求值给）：
               出生日登记之后，这里出现的是"几格 · 每格一周 · 起点哪天"——三枚数摆在一起，
               读者手里就有复算这一片格子的全部输入（构建日就在上一行）。
               ⚠️ 拿不到时这里说的是"没有"。假值那一族（退回一个数／留一枚占位格）§12:1000 与 §15 都点过名，
               坏字面不在这份产物里抄第二遍——理由照上面年度弧那段注释那条：注释会随产物一起发出去，
               拿 grep 当判据时它自己就会被自己的例子命中。 -->
          <div>
            <dt>一生格子</dt>
            <dd>{born
              ? `${life.weeks} 格 · 每格一周 · 起点 ${BIRTH_DATE}`
              : '还没有可用的出生日，所以这一片格子一格都不画——每一格都得由出生日与构建日复算，起点没登记，就没有一格算得出来。'}</dd>
          </div>
        </dl>
        <!-- 数据到位那天才出现的格子：markup 由 src/lib/lifegrid.js 那一份渲染器给（页面与尺子同一份实现）。
             aria-hidden：这一块是那一行读数的图形化，文字行已经把"几格"说给读屏的人了，这里不留第二句可打脸的话。 -->
        {born ? <div class="life-grid" aria-hidden="true" set:html={lifeFieldHtml(birth, f.now)}/> : null}
        <!-- 年度弧（规范 §6 苔时弧那套画法的第二次使用，§15）：画的正是"构建这一刻，今年已经走完的这一段"。
             ⚠️ 只给形状、不给读数：这一行不写"第 N 天"也不写百分比，页面上出现的那个 dashoffset 是 `f.arc` 里
             算好的属性，读它的人只能读出"走过多少"这一件事。半径/圆心/视框与比值都来自 `src/lib/stats.js`
             里**同一个** `now`——就是上面"构建于"那一格用的那一次求值（§16 一页只许有一个构建时刻），
             所以这一枚弧与那一行时间戳不可能互相打脸。 -->
        <p class="col-year">
          <!-- ⚠️ 表达式里多打一个花括号是**静默**的：模板字符串照收，产物里 rotate 那一串就多出个尾巴，
               astro build 与三类门禁全绿，而 SVG 解析 transform 失败会整条作废它——起点从 12 点掉到 3 点，
               §6 那句"起点在 12 点方向"就地破掉。对账只认产物里那一串 rotate 是什么。
               ⚠️ 这条注释里故意**不抄坏值**：注释会随产物一起发出去，抄一遍"坏例子"就等于在产物里
               放了一个坏例子，拿 grep 当判据时它自己就被自己的例子命中（本轮真踩过）。 -->
          <svg class="yearring" viewBox={`0 0 ${f.arc.box} ${f.arc.box}`} role="img" aria-label="今年已经走完的这一段">
            <circle cx={f.arc.cx} cy={f.arc.cx} r={f.arc.r} transform={`rotate(-90 ${f.arc.cx} ${f.arc.cx})`} stroke-dasharray={f.arc.dasharray} stroke-dashoffset={f.arc.dashoffset}/>
          </svg>
          <span>今年</span>
        </p>
        <p class="col-note">
          这是一份纯静态站点：没有服务端、没有 cookie、没有第三方统计脚本。
          所以这里不放"访问量"——那个数字我们真的拿不到，写一个出来就是假的。
          你的浏览器里只有三行留得住的本地数据：主题、显示设置（雾 / 颗粒 / 萤火 / 入场）、和下面这个载入次数；
          另有三行关掉标签页就消失的会话标记——这次会话看过完整入场没有、从哪一篇回列表、这一轮说过"守夜"没有。
          清掉它们，这个网站不会少一块。
        </p>
        <p class="col-visit" id="col-visit" hidden></p>
      </section>
    </div>
  </main>
</Layout>
