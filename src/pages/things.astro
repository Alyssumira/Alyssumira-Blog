---
import Layout from '../layouts/Layout.astro';
import SearchEntry from '../components/SearchEntry.astro';
import { things } from '../data/site.js';
import { root } from '../lib/markdown.js';
const pad = n => String(n).padStart(2, '0');
---
<Layout title="小东西 · mistwood" desc="做一些小东西，像捡拾林间的石头。" here="things" tier="look">
  <main class="wrap">
    <header class="page-head reveal">
      <h1 class="page-title">小东西</h1>
      <div class="sec-label">things — <b>{pad(things.length)}</b> →<SearchEntry /></div>
    </header>

    <div class="things-grid">
      {things.map(t => {
        /* `link: "#"` 是 §12 那条死锚点：点了只回页顶。没填真地址就干脆不给 href——
           这张卡此时是一块图鉴（名字 + tag + 一片占位雾），不是一个看起来坏了的按钮。
           填上链接它就重新可点，反馈跟着 `.thing[href]` 一起回来（§8.3 每个可点元素 1 个主反馈） */
        const href = t.link && t.link !== '#' ? t.link : null;
        return (
          <a class="thing reveal" {...href ? { href } : {}}>
            {t.shot && <img class="shot" src={root(t.shot)} alt="" loading="lazy">}
            <div class="thing-bar"><h3>{t.name}</h3><span>{t.tag}</span></div>
          </a>
        );
      })}
    </div>
  </main>
</Layout>
