---
import '../styles/notes.css';
import Layout from '../layouts/Layout.astro';
import SearchEntry from '../components/SearchEntry.astro';
import { notes } from '../data/site.js';
import { inlineMd } from '../lib/markdown.js';
import { tone } from '../lib/stats.js';
const pad = n => String(n).padStart(2, '0');
---
<Layout title="notes · mistwood" desc="观察日志：日期，加一两句话。" here="notes">
  <main class="wrap">
    <header class="page-head reveal head-notes">
      <h1 class="page-title">碎碎念</h1>
      <div class="sec-label">notes — <b>{pad(notes.length)}</b> →<SearchEntry /></div>
    </header>

    <div class="notes-list">
      {notes.map(n => (
        <div class="note reveal">
          <time>{n.date} · {n.weather}</time>
          <p class={tone(n.text)} set:html={inlineMd(n.text)}></p>
        </div>
      ))}
    </div>
  </main>
</Layout>
