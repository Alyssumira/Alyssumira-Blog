---
/* 一个标签页 /tags/<slug>/：贴过这个记号的稿子一次性全列出来（零请求、零 JS、零"加载更多"）。
   地址与 /tags/ 索引、详情页的胶囊同一份算法（lib/taxonomy.js 的 taxSlug），三处不会各拼一遍。 */
import Layout from '../../layouts/Layout.astro';
import PostRow from '../../components/PostRow.astro';
import { visiblePosts } from '../../lib/posts.js';
import { tagGroups, bySize } from '../../lib/taxonomy.js';

export async function getStaticPaths(){
  const posts = await visiblePosts();                 /* 草稿的稿子不会出现在这里的任何一行 */
  return bySize(tagGroups(posts)).map(g => ({ params: { name: g.slug }, props: { group: g } }));
}
const { group } = Astro.props;
const pad = n => String(n).padStart(2, '0');
---
<Layout title={`${group.name} · 标签 · mistwood`} desc={`贴了「${group.name}」的 ${group.posts.length} 篇。`}>
  <main class="wrap">
    <header class="page-head reveal">
      <h1 class="page-title">{group.name}</h1>
      <span class="sec-label">tag — <b>{pad(group.posts.length)}</b> 篇 · <a class="tax-back" href="/tags/">全部标签</a></span>
    </header>

    <ol class="essay-index">
      {group.posts.map((p, i) => <PostRow post={p} n={i + 1} />)}
    </ol>
  </main>
</Layout>
