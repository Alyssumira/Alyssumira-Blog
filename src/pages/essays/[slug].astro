---
import '../../styles/essay.css';
import Layout from '../../layouts/Layout.astro';
import { renderMd, fmtDate, strictHref } from '../../lib/markdown.js';
import { visiblePosts } from '../../lib/posts.js';
import { categoryOf, tagsOf, taxSlug } from '../../lib/taxonomy.js';
import { lastRevisionDate, whenLine } from '../../lib/revised.js';
/* 字数向 stats.js 要，不在这一页重新数一遍（文件头那句"列表页与关于页的总计必须是同一把尺子"
   同样管详情页）：cjkCount / latinWords 是 readMinutes 与 siteFacts.words 已经在吃的同一对函数，
   所以每一篇报的字数与关于页那个总数逐篇相加一定对得上——第三把尺子从一开始就不许存在。 */
import { cjkCount, latinWords } from '../../lib/stats.js';

export async function getStaticPaths(){
  /* ⚠️ 这一格最容易漏：草稿过滤漏在 getStaticPaths 里，就是"列表搜不到、详情页照样能访问"那种最坏的假完成
     ——地址、og:url、上一层 prev/next 全都会带着它。所以这里也只准调 visiblePosts()，不再各写一遍 filter。
     顺序（置顶在最前）一并由它给，下面的 prev/next 邻居因此跟着新顺序走。 */
  const posts = await visiblePosts();
  /* 「改于」向 git 要，不向 front matter 要（§15 详情页那一格）：一次并发问完，问不到的那篇退 undefined。
     ⚠️ 判据的来源是 post.filePath（glob loader 交的是"相对 config.root"的路径），不是从 slug 拼一串——
     拼出来的那串碰上子目录稿件就指到不相干的文件，宁可不显示也不许指错。 */
  const revised = await Promise.all(posts.map(p => lastRevisionDate(p.filePath)));
  return posts.map((p, i) => ({ params: { slug: p.id }, props: { post: p, prev: posts[i - 1], next: posts[i + 1], revised: revised[i].date } }));
}
const { post, prev, next, revised } = Astro.props;
const sub = post.data.excerpt;
/* 写作时辰（§7）：月份从 date 推是事实，小时只能来自 front matter 的 hour。
   没填就整行不出现——"写于一个傍晚"这种话猜不得。
   ⚠️ 同在这一行后面接「改于 <日期>」（第九轮，数据源是 git）：同日或更早不显示，两种读数同一行同一套灰度，
   所以这一页从头到尾只有一行"什么时候写的"，没有第二块、也没有第二种灰度（§15 详情页那一格）。 */
const MONTH_CN = ['一','二','三','四','五','六','七','八','九','十','十一','十二'];
function whenOf(d, hour){
  if (hour === undefined || hour === null) return '';
  const w = hour >= 5 && hour < 9 ? '清晨'
    : hour >= 9 && hour < 12 ? '上午'
    : hour >= 12 && hour < 14 ? '正午'
    : hour >= 14 && hour < 17 ? '下午'
    : hour >= 17 && hour < 20 ? '傍晚'
    : hour >= 20 ? '深夜' : '凌晨';
  return `写于一个${MONTH_CN[d.getUTCMonth()]}月的${w}`;
}
const when = whenOf(post.data.date, post.data.hour);
/* 一行两读：when 来自 front matter 的 hour（可空），rev 来自 git（拿不到就 undefined）。
   两个都空 ⇒ 整块不出现，和第五轮那条"空着一个字都不显示"同一条路。 */
const whenText = whenLine(when, post.data.date, revised);
/* 分类与标签（§9 那枚在册候选今天启用）：**没填 ⇒ 这一整块不出现**，不是"出现一条空的"。
   归一化与 slug 都在 lib/taxonomy.js——详情页的胶囊与分类/标签索引页必须是同一份清单，两处各算迟早分叉。 */
const cat = categoryOf(post), catSlug = taxSlug(cat);
const tags = tagsOf(post);
const hasTax = !!catSlug || tags.length > 0;
/* 每篇字数：构建期从**渲染前的稿子**（post.body，那份 md 原文）数，数得出才写（§12 假数字那一格）。
   ⚠️ 入参与 siteFacts 数 `p.body` 同一份，不是渲染后的 HTML：标签里的字母会被数成字。
   ⚠️ 没有"约"、没有向上取整、没有估——它是一枚加法的结果，读者拿稿子自己数应当一模一样。 */
const words = cjkCount(post.body) + latinWords(post.body);
/* 正文里有没有图版：渲染结果里那一枚 `<figure class="shot">` 的开标签，构建期数一次。
   零枚 ⇒ 下面那一整块 `<dialog>` 连同它的收起钮**一个字节都不进产物**（"没填 ⇒ 整块不出现"，
   与 hasTax / whenText 同一条模式；不是发一块再 display:none）。
   ⚠️ 判据不写成运行时的 querySelectorAll：那样静态产物里就永远躺着一枚没人认领的空 dialog。 */
const bodyHtml = renderMd(post.body);
const hasShot = /<figure class="shot"/.test(bodyHtml);
/* ---- 稿件级转载许可族（§15 详情页那一格，第十五轮 `card/permit`）----
   四枚都可空，**没填 ⇒ 这一段一个字节都不出现**（与上面 whenText / hasTax / hasShot 同一条模式，
   不是"发一块再 display:none"）。落点是 `.post-tail` 里的一枚 `<p class="post-when">`：
   复用上面"写于／改于"那一行**同一份声明**（§3 的"说明 14"档、14px 宋体 `--ink-2`、`margin-top:14px`），
   所以**零新 CSS、零新垂直槽位**——`tools/gap-check.mjs` 那 142 枚与 `.post-tail` 那枚在册 56px 一个字没动，
   `essay.css` 也没有新规则（新一条 `margin-top` 就得进注册表，而这张卡不许碰那把尺子）。
   一行两读今天扩成一行四读：段与段之间 ` · `，同一套灰度，不新开一块。
   ⚠️ **`author` 不回落到 `src/data/site.js` 的 `AUTHOR`**（本轮裁决，schema 那边钉着同一条）：回落就是
   替作者署名——一枚"作者签了名但其实没写"的假语境。所以 `sourceLink` 非空而 `author` 空着的那一格，
   出处那一段**整段不出现**；许可那一段按自己的主键 `licenseName` 判，两者都空、只填了 `licenseName`
   时许可照旧上屏。规则一句话：**每段有一枚"名字"当主键，URL 只是它的路**。少一项不是错，多一项才是。
   ⚠️ 消毒只有 `markdown.js` 那一处真值，而这一行吃的是它导出的 **`strictHref()`**（"要么能用、要么没有"）：
   协议判据仍然只有 `OK_LINK`／`HAS_SCHEME` 那两枚正则加 `href()` 一处，**这里不重写第二份**——为什么这里不重跑一遍
   协议白名单：两处各算一遍，迟早有一处漏掉 `javascript:`（`content.config.ts` 头上钉着同一条，`markdown.js`
   文件末导出表那一格记着它为什么存在）。
   ⚠️ **这一族永不产出 `href="#"`，也永不把缺协议头的串当站内路径**（补丁轮 `card/permitfix` 的牙；两种坏形状各自的表现）：
      ① `sourceLink` 坏（缺协议头 ⇒ `root()` 会把它钉成 `/example.com/x` 那种点开 404 的活锚；或协议不合格 ⇒ 消毒成 `#`）
      ⇒ **整段"原文 …"不出现**，而 `"本文作者 "` 那一段照常上屏——它的主键是 `author`、与路无关。理由：这一段的"名字"
      就是那条地址本身，地址不可走 ⇒ 这个名字对读者没有价值；而"少一项不是错，多一项才是"是同族先例（上面 `author`
      空 ⇒ 整段不出现那条）。② `licenseUrl` 坏 ⇒ **锚点撤掉，`许可 <licenseName>` 仍作为散文出现**——`licName` 是主键，
      路缺位只是没得点。两种落点都走下面 `licenseSegs.push` 那两行**已经建好的** `url ? <a> : text` 那条分叉（也就是
      本块末尾"路缺位 ⇒ 字仍作散文"那条），**零新分支**，只是让它也接住"坏地址"。
   ⚠️ 判"填没填"用的是**原始字符串**非空，消毒后的结果只在真的进链接时才算：`href('')` 会被 `root()`
   解成 `/`（相对路径钉站点根），那是一枚作者什么都没写却出现在页面上的活锚点，必须赶在进消毒函数之前挡掉
   （`strictHref('')` 自己也是空串，这一道是留着的第二防线，不是拿来省事的）。
   ⚠️ `target="_blank" rel="noopener noreferrer"` 无条件挂在这两枚外链上（写法口径照 `markdown.js` 的 `link()` 那一条，
   rel 组合不新开一套）；这里不再判第二次协议——判协议是 `markdown.js` 那一处的事。
   ⚠️ 这段说明留在 `---` 里而不是写成模板里的 HTML 注释：Astro 把 HTML 注释**原样落进产物**，
      那样"三篇稿子四枚全空 ⇒ 产物一字不变"当场就破（§14 那条"注释里的地址访客走不到"同一个方向的反面——
      注释在产物里，它就是产物）。
   ⚠️ 落位：`.post-tail` 的末位，排在盖章／专注／回执之后。那枚回执平时带 `hidden`（`display:none`），
      所以填了许可时这一行紧接在按钮那一行下面，吃的是 `.post-when` 自己那枚在册 14px——不是新的一段节奏。
   ⚠️ 纸上不出现：`.post-tail` 整块由 `base.css` 打印段那条 `html .post-tail{display:none}` 接住
      （§19.1 那张撤场清单里已有这一行，与专注模式那一枚同一格理由），这里不为打印再写一条。
   ⚠️ 段里 `text`（这段的字）与 `url`（这段的路）是两枚分开的判据：**路缺位 ⇒ 字仍要作为散文出现**
      （`许可 CC BY-NC 4.0` 没有锚点），**字缺位 ⇒ 整段不出现**（上面那条主键规则）。
      合成一枚条件写会漏掉前者——实测过：只填 `licenseName` 那一格当时落下的是光秃秃一枚「许可 」。 */
const seg = (v) => String(v ?? '').trim();          /* schema 给的是 ''（没填），但 YAML 里可能落 null：挡一道 */
const byline = seg(post.data.author);
const sourceRaw = seg(post.data.sourceLink);
const licName = seg(post.data.licenseName);
const licUrlRaw = seg(post.data.licenseUrl);
/* 各算一次、两处都用同一个值（链接的文字与 href 是同一枚消毒结果，不在那里再解一遍）。
   strictHref() 交回空串 = 这一枚地址不能当路用：出处那一段因此整段不出现（下面 if (sourceHref)），
   许可那一段退回没有锚点的散文（下面 url ? <a> : text）——两枚值都不许是 '#'，也不许是钉到站点根的相对路径 */
const sourceHref = sourceRaw ? strictHref(sourceRaw) : '';
const licHref = licUrlRaw ? strictHref(licUrlRaw) : '';
const licenseSegs = [];
if (byline){
  licenseSegs.push({ pre: '本文作者 ', text: byline, url: '' });
  if (sourceHref) licenseSegs.push({ pre: '原文 ', text: sourceHref, url: sourceHref });
}
if (licName) licenseSegs.push({ pre: '许可 ', text: licName, url: licHref });
---
<Layout title={`${post.data.title} · mistwood`} desc={sub || post.data.title} here="essays" type="article" date={post.data.date} revised={revised}>
  <!-- JSON-LD 要的这两枚就取自上面已经算好的 prop，不另问一次 git、也不从 slug 反推路径（:10-12 那条禁令同样管这里）：
       revised 是 git 里最后一次改动型提交的日历日（问不到＝undefined ⇒ Seo 那一键整块不写），date 是 front matter 那天。
       ⚠️ 这里只是把「已经在这儿的值」交给 Layout，页面上那行「改于」的判据与灰度一个字没动（§7 / §15）。 -->
  <div id="progress" aria-hidden="true"></div>
  <!-- 章节刻度（§6.3）：同一批标题（H2 ＋ 本轮起也算 H3，与右侧目录同一个选择器）在这条线上的位置。
       右侧目录给名字，这一排给形状——窄屏没有目录，刻度还在。
       aria-hidden：它是这一篇结构的图形化重述，读屏已经有目录 -->
  <div id="progress-marks" aria-hidden="true"></div>
  <nav id="toc" aria-label="目录"></nav>

  <main class="wrap">
    <header class="post-head reveal">
      <p class="post-meta">{fmtDate(post.data.date)} · essay · {words} 字</p>
      <h1 class="post-title">{post.data.title}</h1>
      {whenText && <p class="post-when">{whenText}</p>}
      {sub && <p class="post-sub">{sub}</p>}
      {hasTax && (
        <p class="chip-row">
          {catSlug && <a class="chip" href={`/categories/${catSlug}/`}>{cat}</a>}
          {tags.map(t => <a class="chip" href={`/tags/${taxSlug(t)}/`}>{t}</a>)}
        </p>
      )}
    </header>

    <!-- 正文走 §15 的排版白名单解析器，构建期落成静态 HTML -->
    <article class="post-body reveal" id="post-body" set:html={bodyHtml}></article>

    <!-- 正文配图灯箱：`hasShot` 为假 ⇒ 这一整块不存在（连那枚原生对话框的开标签都不落进产物，
         所以"数产物里有没有灯箱"这条判据读得到的是节点、不是这句说明——同 §14 那条"注释里的地址
         访客走不到"的口径，本卡实测过一次假红，说明里就不许写那个字面量）。
         在场的时候它也只有这一枚收起钮——大图与图注由 site.js 在第一次打开时造出来：
         那时才知道要点哪一张，而造早了就是一张没有 src 的空面（假位置，§12）。
         ⚠️ 收起钮是文字钮、吃 .post-act 那条声明（与盖章/专注同族，零新按钮形状）；
         Esc 与焦点陷阱由原生对话框的 showModal() 给，不是我们模仿的（§12:788 那条教训的反面：
         能点开的东西必须也能 Tab 到、也能按下去，触屏也收得回来）。 -->
    {hasShot && (
      <dialog id="lightbox" class="lightbox" aria-label="正文配图 · 放大看这一张">
        <button class="post-act lightbox-close" type="button">close · 收起这一张</button>
      </dialog>
    )}

    <!-- 盖章：分享＝把这一篇收下来。只落一行手记字，不画圆章（理由见 essay.css 与 §15） -->
    <div class="post-tail reveal">
      <button class="post-act" id="post-stamp" type="button">share · 把这一篇收进手记</button>
      <!-- 专注模式（§15 第九轮）：这一行里的第二枚，与盖章同源（共用 .post-act 那一条声明）。
           按下去撤两层：身后的雾（mask）+ 方向光落在正文上的部分——两条 CSS 与全部理由在 essay.css。
           ⚠️ `hidden` 是静态 HTML 就带着的：显形只由 site.js（打包的模块脚本）做，所以无 JS / 存储读不到
              时这一页与今天逐字节相同。故意**不**写进 Layout.astro 那段 `<script is:inline>`——那会牵动
              §16 第四类门禁"内联脚本同步落地五枚属性"的断言对象（§2.3 末"判定没搬进内联脚本"同一个理由）。
           ⚠️ 标签里不写机制（不写"撤雾"）：prefers-reduced-motion 下本来就没有雾可撤，写了就是 §12 那种假语义。
           aria-pressed 由脚本跟着状态翻；它是 <button type=button>，不是 href，所以 §12 死锚点那条管不到它。 -->
      <button class="post-act post-focus" id="post-focus" type="button" hidden aria-pressed="false">focus · 只看字</button>
      <p class="stamp-note" id="stamp-note" hidden></p>
      {licenseSegs.length > 0 && (
        <p class="post-when">{licenseSegs.map((s, i) => <>
          {`${i > 0 ? ' · ' : ''}${s.pre}`}
          {s.url ? <a class="post-act" href={s.url} target="_blank" rel="noopener noreferrer">{s.text}</a> : s.text}
        </>)}</p>
      )}
    </div>

    <nav class="post-nav reveal">
      {prev && <a href={`/essays/${prev.id}/`}><span>← prev</span>{prev.data.title}</a>}
      {next && <a class="next" href={`/essays/${next.id}/`}><span>next →</span>{next.data.title}</a>}
    </nav>

    <!-- 纸上一页脚（§19.5）：屏幕上 `display:none`，一个像素都不占（`base.css` 的打印段里才亮起来）。
         日期取这篇的 front matter `date`，与上面 `.post-meta` 同一个 `fmtDate`、同一个入参——
         打印当日是一个与内容无关的数，纸不许替访客说话（§16 那条"一个页面只许有一个构建时刻"同族）。 -->
    <footer class="print-foot">mistwood · essays · {fmtDate(post.data.date)}</footer>
  </main>
</Layout>
