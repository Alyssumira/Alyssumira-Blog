---
import '../../styles/essay.css';
import Layout from '../../layouts/Layout.astro';
import { renderArticle, fmtDate, strictHref } from '../../lib/markdown.js';
import { visiblePosts, publishedPosts } from '../../lib/posts.js';
import { categoryOf, tagsOf, taxSlug, isUnlisted } from '../../lib/taxonomy.js';
import { seriesOf, seriesSiblings } from '../../lib/series.js';
/* 相关阅读（第十八轮 `card/reading2`，F4）：判据全部住在 `src/lib/related.js` 那一份**纯**实现里
   （不 import 'astro:content'，所以 `tools/reading-check.mjs` 吃的是同一个函数），这一页只做两件事：
   把 `visiblePosts()` 那份数组交进去、把拿回的清单画成链接。规则（唯一的排序信号＝共享的真 token 枚数、
   平票保持池子顺序、上限 3 枚、任一侧零 token ⇒ 整块不出现、草稿与不列入不可能在里面）
   逐条钉在那份文件的头上，这里不重述第二遍——重述就是给同一件事立第二处真值。 */
import { relatedPosts } from '../../lib/related.js';
import { crumbTrail } from '../../lib/nav.js';
import { lastRevisionDate, whenLine } from '../../lib/revised.js';
/* 字数向 stats.js 要，不在这一页重新数一遍（文件头那句"列表页与关于页的总计必须是同一把尺子"
   同样管详情页）：cjkCount / latinWords 是 readMinutes 与 siteFacts.words 已经在吃的同一对函数，
   所以每一篇报的字数与关于页那个总数逐篇相加一定对得上——第三把尺子从一开始就不许存在。 */
import { cjkCount, latinWords } from '../../lib/stats.js';
/* 写信回应（F6）：邮箱地址向 `src/data/site.js` 要，不在这一页抄第二份（§13a 那句"抄的那份改了
   没人知道"管的就是这一族；关于页那一枚今天也改成吃同一份）。 */
import { EMAIL } from '../../data/site.js';

export async function getStaticPaths(){
  /* 这一格里**两枚读函数各管一件事**（第十五轮 `card/unlisted`，口径写在 `src/lib/posts.js` 头上那段），
     混了就两头都坏，所以两行分开、各带一句理由：
     ⚠️ **路**从 `publishedPosts()` 建——它只滤草稿。漏掉这一道就是"列表搜不到、详情页照样能访问"那种最坏的假完成
        （地址、og:url、上一层 prev/next 全都会带着草稿）；反过来把不列入的也一并挡在这里，那一枚地址就当
        不存在了——而这一族要的恰恰是**地址是真的、页面在**，只是没人指过去。
     ⚠️ **邻居**（下面的上一篇／下一篇）从 `visiblePosts()` 算——它多滤一道不列入。顺序（置顶在最前）与
        列表页、两枚 feed 同一份数组，不在这里再排一遍（两处各排迟早分叉）。
        ⇒ 不列入的那一篇拿到的 prev/next 是 `undefined`：**它不在目录里，也就没有邻居**。
        这一行是本卡最容易做歪的一格（把邻居退回整份集合，那一枚稿子立刻在别人的上一篇／下一篇里露头），
        它由 `tools/runtime-check.mjs` 的「不列入对账」那一格在**产物**上逐枚扫 href 钉着——源码级判据原理上
        看不见这件事：列表是干净的、地址是活的，泄漏只露在别人的 `.post-nav` 里。
     ⚠️ 顺带一条：这一页**没有**因为"不列入"就少构建什么——同一个模板、同一份壳，只多一枚 `noindex`（见下面 `<Layout>`）。 */
  const routable = await publishedPosts();
  const listed = await visiblePosts();
  const nb = new Map(listed.map((p, i) => [p.id, { prev: listed[i - 1], next: listed[i + 1] }]));
  /* 相关阅读（F4）的池子＝**同一份** `listed`：名单不在这里再排一遍、也不换个读函数取
     （`publishedPosts()` 那枚"含不列入"的建路读函数一旦被拿来算相关，不列入的那一篇立刻
     出现在别人的"相关的几篇"里——与上面 prev/next 那一格是同一枚牙，`tools/reading-check.mjs`
     在产物上逐枚扫 href 钉着）。逐枚在**构建期**算好放进 props，模板里一个字节都不再算：
     ⚠️ 模板要是在这里问集合，就是给 `getCollection('posts')` 开第二处入口（taxonomy-check ① 红的那种形状）。
     ⚠️ 不列入的那一篇自己也有一格：它的页面照常存在，而它指出去的那几枚全在 `listed` 里 ⇒
        这一格只出不进，"站内任何一处都不指向它"那一条一个字不破（`runtime-check` 的"不列入对账"钉的是"进"）。 */
  const rel = new Map(routable.map(p => [p.id, relatedPosts(listed, p)]));
  /* 系列内的上一篇／下一篇（F5）：邻居只从 `src/lib/series.js` 的 `seriesGroups()` 那一枚顺序里取——
     它与 `/series/<slug>/` 那一页列的是**同一枚数组**（整组都有 `seriesOrder` 就按它升序、缺一枚就整组
     退回按 `date`），所以"这一串里的上一枚"在两页上必然是同一个答案；这里不再排第二遍（§15"顺序只住一处"）。
     ⚠️ 对账在 `tools/reading-check.mjs`：它拿系列页产物里那排 `.row` 的地址顺序反查详情页这两枚链接，
        两页哪天分叉，红的是那一格，不是这份注释。
     ⚠️ 池子同样只准是 `listed`：拿 `publishedPosts()` 那枚"含不列入"的建路读函数去算邻居，
        不列入的稿子就会坐进每一组的邻居位——与上面 prev/next、related 是同一枚牙。 */
  const sn = new Map(routable.map(p => [p.id, seriesSiblings(listed, p)]));
  /* 「改于」向 git 要，不向 front matter 要（§15 详情页那一格）：一次并发问完，问不到的那篇退 undefined。
     ⚠️ 判据的来源是 post.filePath（glob loader 交的是"相对 config.root"的路径），不是从 slug 拼一串——
     拼出来的那串碰上子目录稿件就指到不相干的文件，宁可不显示也不许指错。 */
  const revised = await Promise.all(routable.map(p => lastRevisionDate(p.filePath)));
  return routable.map((p, i) => {
    const at = nb.get(p.id);
    const s = sn.get(p.id);
    return { params: { slug: p.id }, props: { post: p, prev: at?.prev, next: at?.next, related: rel.get(p.id) ?? [], seriesPrev: s?.prev, seriesNext: s?.next, revised: revised[i].date } };
  });
}
const { post, prev, next, related, seriesPrev, seriesNext, revised } = Astro.props;
/* 不列入（第十五轮 `card/unlisted`）：这一页对那一枚键只做两件事，**页面本身照常是它**——
   ① 给壳传 `noindex={isUnlisted(post)}`（条件那一行在 `src/layouts/Layout.astro`，§13a 记过的同一招），
   ② 拿不到邻居 ⇒ 下面那一整块 `.post-nav` 不出现（口径在上面 `getStaticPaths` 那一段）。
   标题、正文、og、许可行、系列行一个字都不减：这一族少的只是"别人指向它"与"机器把它收进索引"两件事，
   不是这一页的内容。判据不在这里重写——`isUnlisted()` 住在 `src/lib/taxonomy.js`，`tools/` 那几格吃同一份。 */
const unlisted = isUnlisted(post);
const sub = post.data.excerpt;
/* 写作时辰（§7）：月份从 date 推是事实，小时只能来自 front matter 的 hour。
   没填就整行不出现——"写于一个傍晚"这种话猜不得。
   ⚠️ 同在这一行后面接「改于 <日期>」（第九轮，数据源是 git）：同日或更早不显示，两种读数同一行同一套灰度，
   所以这一页从头到尾只有一行"什么时候写的"，没有第二块、也没有第二种灰度（§15 详情页那一格）。 */
const MONTH_CN = ['一','二','三','四','五','六','七','八','九','十','十一','十二'];
function whenOf(d, hour){
  if (hour === undefined || hour === null) return '';
  const w = hour >= 5 && hour < 9 ? '清晨'
    : hour >= 9 && hour < 12 ? '上午'
    : hour >= 12 && hour < 14 ? '正午'
    : hour >= 14 && hour < 17 ? '下午'
    : hour >= 17 && hour < 20 ? '傍晚'
    : hour >= 20 ? '深夜' : '凌晨';
  return `写于一个${MONTH_CN[d.getUTCMonth()]}月的${w}`;
}
const when = whenOf(post.data.date, post.data.hour);
/* 一行两读：when 来自 front matter 的 hour（可空），rev 来自 git（拿不到就 undefined）。
   两个都空 ⇒ 整块不出现，和第五轮那条"空着一个字都不显示"同一条路。 */
const whenText = whenLine(when, post.data.date, revised);
/* 分类与标签（§9 那枚在册候选今天启用）：**没填 ⇒ 这一整块不出现**，不是"出现一条空的"。
   归一化与 slug 都在 lib/taxonomy.js——详情页的胶囊与分类/标签索引页必须是同一份清单，两处各算迟早分叉。 */
const cat = categoryOf(post), catSlug = taxSlug(cat);
const tags = tagsOf(post);
const hasTax = !!catSlug || tags.length > 0;
/* 系列（第十五轮 `card/series`，§15「系列页」那一格）：与上面分类/标签同一个口径——
   **没填 ⇒ 这一整行不出现**，不是"出现一条空的"（也不是画一枚指向 `/series//` 的死锚点，§12）。
   名字与 slug 都向 `src/lib/series.js` 与 `taxonomy.js` 的 `taxSlug()` 要，这里不写第二份归一化：
   `series: "。"` 那种纯符号名归一化之后是空串 ⇒ 拿不到地址 ⇒ 也拿不到这一行；"作者写了却不出现"
   那一面由 `tools/new-post.mjs --check` 当面说破（它与 category 用的是同一格判据，不在这里重做）。
   ⚠️ 只印名字，**不印序数**（没有「第 N 篇」）：没有 `seriesOrder` 就没有 N，编一个是 §12 的假数字；
   整组都有 order 时也不印。组内枚数（`共 M 篇`）是数得出的真值，它住在 `/series/` 那一页，不在这里。
   ⚠️ 落点与形状见模板里那一行：`.post-tail` 末位、许可那一行之后，`<p class="post-when">` ＋ 锚点挂
   `.post-act`——**`card/permit` 那一招的再一次使用（同一份声明、同一个宿主那一族）** ⇒ 零新 CSS、
   零新垂直槽位，`tools/gap-check.mjs` 那 142 枚与圆角那 30 枚一个都不动（新一条带上下 px 的规则就得进注册表，
   这一族不许碰那两把尺）。锚点为什么必须挂 `.post-act`：`base.css` 的 `a{ color:inherit; text-decoration:none }`
   会让裸 `<a>` 在这一行里读不出是链接（§2.4），而 `.post-act` 已经在 `.post-tail` 里管着这一族的链接——
   不新开第二种材质。站内地址，因此**不挂 `target`**：上面 `tabAttrs` 那枚 `^https?:` 的条件天然不成立，
   这里也不重写第二份协议判据。 */
const seriesName = seriesOf(post), seriesSlug = taxSlug(seriesName);
/* 相关阅读（F4，`docs/美化建议.md` §11.3 那格预签的"第二批 P1"第一枚）：清单由 `getStaticPaths` 里
   那份 `relatedPosts(listed, post)` 算好交下来（池子＝`visiblePosts()`，与上下篇、两枚 feed 同一份数组），
   这一格只把它**画出来**。落点是 `.post-tail` 的末位——那块就是"读完这篇之后"的那一排，
   而它下面紧挨着的就是上下篇那一块（`.post-nav`），所以这一格确实住在"上下篇附近"那一格里。
   ⚠️ **零新 CSS、零新垂直槽位**（`card/permit`／`card/series` 那一招的第三次使用）：行是
   `<p class="post-when">`（在册 14px／`--ink-2`／`margin-top:14px`），链接挂 `.post-act`
   （在册那一条 mono 12px 声明），`src/styles/**` 一个字没改 ⇒ `gap-check` 那 142 枚与圆角那 30 枚一个不动。
   ⚠️ **没填 ⇒ 整块不出现**：三篇稿子的 `category` 与 `tags` 今天全空着 ⇒ `related` 是空数组 ⇒
   产物里这一行一个字节都没有（不是"出现一条空的"、也不留一行"还没有相关推荐"，§14 那条）。
   ⚠️ 行首那枚拉丁标签 `related` 与中文标题分两层（§7"两层各管一种语言"，同 `series ·`／`← prev` 那一族）；
   标签本身不是链接——它没有对应的页面（`/related/` 这种东西不存在，画出来就是 §12 的死锚点）。
   ⚠️ 站内地址，因此不挂 `target`，与上面 `tabAttrs` 那枚 `^https?:` 的条件天然不成立；这里不重写第二份协议判据。 */
const relatedSegs = (related ?? []).map(r => ({ href: `/essays/${r.id}/`, text: r.data.title }));
/* 系列内的上一篇／下一篇（F5）：两枚邻居由 getStaticPaths 里那一次 `seriesSiblings(listed, post)` 交出，
   顺序与 `/series/<seriesSlug>/` 那一页从上往下数的是同一枚数组（理由与两种排序档在 `lib/series.js` 头上）。
   ⚠️ 与全站按日期的上下篇**分开住**，因为它们是两件事：那一块（`.post-nav`）说的是"这个站里比我早一篇／
      晚一篇"，这一行说的是"同一串里我的上一枚／下一枚"。合并成一块就会让同一个位置说两件事——
      读者点下去之前不知道该落到哪一串里（`docs/美化建议.md` F5 那句"并存但分开"钉的就是这个）。
      形状上也分开：那一块是 22px 衬线大字 ＋ `← prev`／`next →`，这一行是 `.post-when` 那 14px 说明 ＋
      `.post-act` 那 12px 等宽链接（与许可行／系列行／相关行同源）⇒ 零新 CSS、零新垂直槽位。
   ⚠️ **不印序数**（没有「第 N 篇」）：`seriesOrder` 可以整组都没填，编一个 N 就是 §12 的假数字（§15 那条）。
   ⚠️ 三种拿不到邻居的情形（没填系列／这一组只有一篇／这一篇不列入）都整块不出现，不留一条空的（§14）。
   ⚠️ 行里的字面只两样：拉丁标签 `in series` 与中文方向词 `上一篇`／`下一篇`，中间夹的是**标题本身**——
      标题与地址都由 `seriesSiblings()` 交回的那一枚 post 现取，不在这里抄第二份。 */
const seriesNavSegs = [];
if (seriesPrev) seriesNavSegs.push({ href: `/essays/${seriesPrev.id}/`, text: `← 上一篇 ${seriesPrev.data.title}` });
if (seriesNext) seriesNavSegs.push({ href: `/essays/${seriesNext.id}/`, text: `${seriesNext.data.title} 下一篇 →` });
/* 写信回应（F6，`docs/美化建议.md` §11.3 预签的"第二批 P1"第三枚）：文末一枚 mailto，
   `subject` 预填这一篇的篇名，**正文留空**——回信写什么归读者，我们不替他起头（塞一句模板话进去
   就是 §12 那种假语义：那几行字看起来像作者说的，其实谁都没说）。
   ⚠️ 这是"评论"在纯静态下的正确形态，不是它的替身演员：没有评论区、没有 Webmention、没有统计、
      没有后端（§12 那两条"评论区 / Webmention 不做"与"编一个访问量"在这一格都被绕开了——
      回应走到信里，站上不留任何一枚我们拿不到的数）。
   ⚠️ 地址只有一个出处：`src/data/site.js` 的 `EMAIL`（关于页那一枚吃的是同一枚；两页各抄一份邮箱
      就是 §13a 点名的"抄的那份改了没人知道"）。那一枚空着 ⇒ 这一整行不出现（§14"没填 ⇒ 不出现"，
      `href=""` 是一枚点了停在原地的活壳）。
   ⚠️ subject 走 `encodeURIComponent`：今天三篇的篇名就带着中文与 ` · `，随时可能出现引号——
      不编码的话 `#` 会被当成片段起点、`&` 会开出第二枚参数、`%` 会留下半截转义，
      那封邮件到达时主题已经不是这一篇的名字（RFC 6068 里 mailto 的参数本来就必须百分号编码）。
   ⚠️ 形状：`.post-act` 那一族的**文字链接**，与许可行／系列行／相关行同一条声明——不是胶囊、
      不是第四种按钮形状（§9 那句"没有一枚是胶囊形"照旧成立，那一格的枚数账本轮跟着改）。 */
const letterHref = EMAIL ? `${EMAIL}?subject=${encodeURIComponent(post.data.title)}` : '';
/* 回到这一篇的开头（第十九轮 `card/topact`）：形状不是本卡定的——§15 第十一轮那一格裁掉悬浮圆钮**那一笔**里
   就写死了唯一合法形态："并进 `.post-act` 那一族做一枚文字钮（同一条声明，零新形状），并同步把 §9 那句的枚数
   与'没有一枚是胶囊形'改成现值"。这里不重审那条裁决（第五个模糊面／第二种材质那两笔账在它自己那一格），只照它施工。
   ⚠️ **无 JS 的真链接**：一枚吃 `.post-act` 的 `<a>`，片段值由 `TOP_ID` 一处给（靶与 href 两处各写一遍字面量，
   就是同一件事立两处真值——改名那天必然只改中一边，产物当场变成 §12 那种死锚点）。靶是同一页 `<header class="post-head">`
   上新加的一枚 `id`：本篇的头（面包屑＋篇名）就是"这一篇的开头"，`<main>` 与它同一枚上缘、而那三枚 `position:fixed`
   的节点（进度条／刻度／目录）说的不是"这一篇的开头"。只加一枚属性、不包任何元素。
   ⚠️ `#`（空片段，点了停在原地）与 `#top`（浏览器特判，没有靶也照样滚）都不算靶——判据是**片段必须在这份产物里
   数得出同值的 id**（`tools/reading-check.mjs` ⑤，两侧都有牙；通用面在 `runtime-check` 的全站具名片段扫描）。
   ⚠️ **不加 `scroll-behavior`、不加点击脚本**（§17 运行时普查那四类：主题／时钟／入场／目录，本卡一枚都不新增）。
   代价照登而不是当省略：落地那一瞬间的行为由 `base.css` 那**条在册**的 `html{scroll-behavior}` 决定（`prefers-reduced-motion`
   下同名那条是 `auto`＝瞬移），本卡一个字没动它，也没为这一枚钮写第二份时序——它因此**不是**"平滑滚回顶部"那种控件。
   ⚠️ **零新 CSS 是这一族的硬口径**（`card/permit`／`card/series`／F4／F5／F6 那一招的再一次使用）：行是
   `<p class="post-when">`（在册 14px／`--ink-2`／`margin-top:14px`），链接挂 `.post-act`（在册那条 12px 等宽声明）
   ⇒ `src/styles/**` 零改动，`gap-check` 那 142 枚间距／30 枚圆角／12 种写法一枚不动。为什么不坐在盖章／专注那一行里：
   那一行的 14px 横档是 `.post-focus{margin-left:14px}` 给的，那枚名字属于专注开关——第三枚要么借一个不属于它的名字
   （假语义），要么新写一条声明（新槽位）；两样都比"多一行在册节奏"贵。
   ⚠️ 标签两层（§7，与 `share ·`／`focus ·`／`letter ·` 同一写法）：拉丁 `top` 说的是去处、中文那半说的是动作；
   `top` 自己**不是**链接（`/top/` 这种东西不存在，画出来就是 §12 的死锚点）。
   ⚠️ 位置：紧跟盖章那一排、排在许可／系列／相关／写信那几行之前——它是"对这一页做的一件事"，那四行说的是
   "这一篇与谁有关"；`letter` 仍是 `.post-tail` 末位（F6 那一格的登记不动）。打印不新写一行：`.post-tail` 整块由
   `base.css` 那条 `html .post-tail{display:none}` 接住（§19.1 清单）。 */
const TOP_ID = 'post-head';
/* 每篇字数：构建期从**渲染前的稿子**（post.body，那份 md 原文）数，数得出才写（§12 假数字那一格）。
   ⚠️ 入参与 siteFacts 数 `p.body` 同一份，不是渲染后的 HTML：标签里的字母会被数成字。
   ⚠️ 没有"约"、没有向上取整、没有估——它是一枚加法的结果，读者拿稿子自己数应当一模一样。 */
const words = cjkCount(post.body) + latinWords(post.body);
/* 正文里有没有图版：渲染结果里那一枚 `<figure class="shot">` 的开标签，构建期数一次。
   零枚 ⇒ 下面那一整块 `<dialog>` 连同它的收起钮**一个字节都不进产物**（"没填 ⇒ 整块不出现"，
   与 hasTax / whenText 同一条模式；不是发一块再 display:none）。
   ⚠️ 判据不写成运行时的 querySelectorAll：那样静态产物里就永远躺着一枚没人认领的空 dialog。 */
const article = renderArticle(post.body);
const bodyHtml = article.html;
/* 这一页的章清单与正文那一排 id 来自**同一次** renderArticle 调用（`card/anchors`，§15 那一格）：
   目录里的每一枚 `href="#x"` 都对着正文里一枚真存在的 `id="x"`，两边同源 ⇒ 不许出现"HTML 里有目录、
   href 指向产物里不存在的 id"那种死锚点（§12），也不许出现"正文有章、目录没有条目"那种半张地图。
   级别（`level`）只交"它是哪一级"这一枚事实，缩进怎么画仍归 CSS（`#toc a.sub`，§9 那条"同一个符号
   不许表达两种状态"）。 */
const heads = article.heads;
const hasShot = /<figure class="shot"/.test(bodyHtml);
/* ---- 稿件级转载许可族（§15 详情页那一格，第十五轮 `card/permit`）----
   四枚都可空，**没填 ⇒ 这一段一个字节都不出现**（与上面 whenText / hasTax / hasShot 同一条模式，
   不是"发一块再 display:none"）。落点是 `.post-tail` 里的一枚 `<p class="post-when">`：
   复用上面"写于／改于"那一行**同一份声明**（§3 的"说明 14"档、14px 宋体 `--ink-2`、`margin-top:14px`），
   所以**零新 CSS、零新垂直槽位**——`tools/gap-check.mjs` 那 142 枚与 `.post-tail` 那枚在册 56px 一个字没动，
   `essay.css` 也没有新规则（新一条 `margin-top` 就得进注册表，而这张卡不许碰那把尺子）。
   一行两读今天扩成一行四读：段与段之间 ` · `，同一套灰度，不新开一块。
   ⚠️ **`author` 不回落到 `src/data/site.js` 的 `AUTHOR`**（本轮裁决，schema 那边钉着同一条）：回落就是
   替作者署名——一枚"作者签了名但其实没写"的假语境。所以 `sourceLink` 非空而 `author` 空着的那一格，
   出处那一段**整段不出现**；许可那一段按自己的主键 `licenseName` 判，两者都空、只填了 `licenseName`
   时许可照旧上屏。规则一句话：**每段有一枚"名字"当主键，URL 只是它的路**。少一项不是错，多一项才是。
   ⚠️ 消毒只有 `markdown.js` 那一处真值，而这一行吃的是它导出的 **`strictHref()`**（"要么能用、要么没有"）：
   协议判据仍然只有 `OK_LINK`／`HAS_SCHEME` 那两枚正则加 `href()` 一处，**这里不重写第二份**——为什么这里不重跑一遍
   协议白名单：两处各算一遍，迟早有一处漏掉 `javascript:`（`content.config.ts` 头上钉着同一条，`markdown.js`
   文件末导出表那一格记着它为什么存在）。
   ⚠️ **这一族永不产出 `href="#"`，也永不把缺协议头的串当站内路径**（补丁轮 `card/permitfix` 的牙；两种坏形状各自的表现）：
      ① `sourceLink` 坏（缺协议头 ⇒ `root()` 会把它钉成 `/example.com/x` 那种点开 404 的活锚；或协议不合格 ⇒ 消毒成 `#`）
      ⇒ **整段"原文 …"不出现**，而 `"本文作者 "` 那一段照常上屏——它的主键是 `author`、与路无关。理由：这一段的"名字"
      就是那条地址本身，地址不可走 ⇒ 这个名字对读者没有价值；而"少一项不是错，多一项才是"是同族先例（上面 `author`
      空 ⇒ 整段不出现那条）。② `licenseUrl` 坏 ⇒ **锚点撤掉，`许可 <licenseName>` 仍作为散文出现**——`licName` 是主键，
      路缺位只是没得点。两种落点都走下面 `licenseSegs.push` 那两行**已经建好的** `url ? <a> : text` 那条分叉（也就是
      本块末尾"路缺位 ⇒ 字仍作散文"那条），**零新分支**，只是让它也接住"坏地址"。
   ⚠️ 判"填没填"用的是**原始字符串**非空，消毒后的结果只在真的进链接时才算：`href('')` 会被 `root()`
   解成 `/`（相对路径钉站点根），那是一枚作者什么都没写却出现在页面上的活锚点，必须赶在进消毒函数之前挡掉
   （`strictHref('')` 自己也是空串，这一道是留着的第二防线，不是拿来省事的）。
   ⚠️ `target="_blank" rel="noopener noreferrer"` **只挂在 `^https?:` 的地址上**——条件是 `markdown.js:43` 里 `link()`
      那一枚 `/^https?:/i.test(raw)`，这一行照它同一形状钉，rel 组合不新开一套。`mailto:` 那种不挂：`strictHref` 照
      `OK_LINK`（`:10`）放行它，无条件挂 `target` 就开出一枚空白新标签页去等邮件客户端（这一族今天不会有 `#`——
      `strictHref()` 那一关早撤了）。**这里判的是"要不要新标签页"，与"能不能用"是两件事**：协议判据仍只有那一处。
   ⚠️ 这段说明留在 `---` 里而不是写成模板里的 HTML 注释：Astro 把 HTML 注释**原样落进产物**，
      那样"三篇稿子四枚全空 ⇒ 产物一字不变"当场就破（§14 那条"注释里的地址访客走不到"同一个方向的反面——
      注释在产物里，它就是产物）。
   ⚠️ 落位：`.post-tail` 的末位，排在盖章／专注／回执之后。那枚回执平时带 `hidden`（`display:none`），
      所以填了许可时这一行紧接在按钮那一行下面，吃的是 `.post-when` 自己那枚在册 14px——不是新的一段节奏。
   ⚠️ 纸上不出现：`.post-tail` 整块由 `base.css` 打印段那条 `html .post-tail{display:none}` 接住
      （§19.1 那张撤场清单里已有这一行，与专注模式那一枚同一格理由），这里不为打印再写一条。
   ⚠️ 段里 `text`（这段的字）与 `url`（这段的路）是两枚分开的判据：**路缺位 ⇒ 字仍要作为散文出现**
      （`许可 CC BY-NC 4.0` 没有锚点），**字缺位 ⇒ 整段不出现**（上面那条主键规则）。
      合成一枚条件写会漏掉前者——实测过：只填 `licenseName` 那一格当时落下的是光秃秃一枚「许可 」。 */
const seg = (v) => String(v ?? '').trim();          /* schema 给的是 ''（没填），但 YAML 里可能落 null：挡一道 */
const byline = seg(post.data.author);
const sourceRaw = seg(post.data.sourceLink);
const licName = seg(post.data.licenseName);
const licUrlRaw = seg(post.data.licenseUrl);
/* 各算一次、两处都用同一个值（链接的文字与 href 是同一枚消毒结果，不在那里再解一遍）。
   strictHref() 交回空串 = 这一枚地址不能当路用：出处那一段因此整段不出现（下面 if (sourceHref)），
   许可那一段退回没有锚点的散文（下面 url ? <a> : text）——两枚值都不许是 '#'，也不许是钉到站点根的相对路径 */
const sourceHref = sourceRaw ? strictHref(sourceRaw) : '';
const licHref = licUrlRaw ? strictHref(licUrlRaw) : '';
/* 这枚地址要不要新开标签页：条件与 `markdown.js:43` 的 `link()` 同一形状（只有 `^https?:` 才挂 target＋rel）。
   它不判"能不能用"——那一处真值仍然只有 `OK_LINK`／`HAS_SCHEME`／`href()`，这里不新开第三份协议判据。 */
const tabAttrs = u => (/^https?:/i.test(u) ? { target: '_blank', rel: 'noopener noreferrer' } : {});
const licenseSegs = [];
if (byline){
  licenseSegs.push({ pre: '本文作者 ', text: byline, url: '' });
  if (sourceHref) licenseSegs.push({ pre: '原文 ', text: sourceHref, url: sourceHref });
}
if (licName) licenseSegs.push({ pre: '许可 ', text: licName, url: licHref });
/* ---- 可见面包屑（第六轮 `card/navcrumb`，`docs/美化建议.md` §11.2 F3）----
   与 JSON-LD 那条链吃**同一个函数**（`src/lib/nav.js` 的 `crumbTrail()`）：屏幕上说的和机器读的
   不会一枚地址各说各话。这里只比机器侧少两样——末节不印、字面走拉丁那一层。
   ⚠️ **字面取 `key`（拉丁小写）不取 `name`（中文）**：§7"两层各管一种语言"，而 `.post-meta` 是
      IBM Plex Mono 的英文标签层——同一行塞中文就是 §7 与 §3 各点名过一次的那个形状（`hour` 那一行
      当初正是为躲它另起了 `.post-when`，14px 宋体）。拉丁那一半**不是新起的名**：它就是导航表第三列
      （`here` 的取值域，`home`／`essays`），而 §19 的纸上一页脚今天已经在写同层同词的
      `mistwood · essays · 2026.09.20`——屏幕上这一行只是把纸上那串里路径的那一半变成能点的。
   ⚠️ **末节（这一篇自己的名字）不印**：它就是下面那枚 42px 的 `<h1>`，同一屏里把篇名再抄一遍小字
      是重复，不是"我在哪"。机器侧照旧带末节（§13a 那一格），因为抓取器读的是那条链的完整形状——
      两边的差别来自层，不是两处各算各的。
   ⚠️ **原先那枚原地标签 `essay` 撤了**：它说的"这一篇属于文章那一栏"现在由能点的 `essays` 说，
      同一行里同一件事只许说一遍（§4 每区块一件事）。日期与字数两枚一个字没动。
   ⚠️ `here` 由这一页的 `HERE` 派生（与下面 `<Layout here={HERE}>` 同一枚常量）：那一枚 prop 管导航
      点亮哪一项，这一枚管面包屑中段取哪一节，说的是同一件事——写两遍字面量就是给同一件事两处真值。 */
const HERE = 'essays';
const crumb = crumbTrail(HERE);
---
<Layout title={`${post.data.title} · mistwood`} desc={sub || post.data.title} here={HERE} type="article" date={post.data.date} revised={revised} noindex={unlisted}>
  <!-- JSON-LD 要的这两枚就取自上面已经算好的 prop，不另问一次 git、也不从 slug 反推路径（:10-12 那条禁令同样管这里）：
       revised 是 git 里最后一次改动型提交的日历日（问不到＝undefined ⇒ Seo 那一键整块不写），date 是 front matter 那天。
       ⚠️ 这里只是把「已经在这儿的值」交给 Layout，页面上那行「改于」的判据与灰度一个字没动（§7 / §15）。 -->
  <div id="progress" aria-hidden="true"></div>
  <!-- 章节刻度（§6.3）：同一批标题（H2 ＋ H3，与右侧目录同一份清单、同一个出处）在这条线上的位置。
       右侧目录给名字，这一排给形状——窄屏没有目录，刻度还在。
       aria-hidden：它是这一篇结构的图形化重述，读屏已经有目录。
       ⚠️ 节点本身是**构建期**烘进 HTML 的（`card/anchors`）：只有 `left` 那个百分比是几何量、非运行时
       量不出来（`site.js` 的 measureMarks），位置与点亮两件事仍然归脚本，但"这一排有没有东西"不再看 JS。 -->
  <div id="progress-marks" aria-hidden="true">{heads.map(() => <span></span>)}</div>
  <!-- 目录：构建期就是一条条真链接（`card/anchors`，§15 那一格）。运行期只剩"高亮正在读的那一章"
       这一件真·运行时职责（§1 的口径：无 JS 时目录仍然在、仍然能跳）。
       ⚠️ `href` 用的那枚 id 与正文那排 id 是同一批字符串（同一次 renderArticle 的产物），
       所以"HTML 里有目录、href 指向产物里不存在的 id"这种死锚点从源头上不成立；
       对账判据在 `tools/runtime-check.mjs` 的「目录⇄正文 id」那一格，两侧都有牙。
       ⚠️ 条目文字走 `set:html`：`h.text` 是渲染结果**去壳**之后的串，里面的 `&` 已经是 `&amp;`，
       再让模板转义一遍就会在屏幕上长出 `&amp;`（与运行期 `a.textContent = h.textContent` 不同读法）。 -->
  <nav id="toc" aria-label="目录">
    {heads.map(h => <a href={'#' + h.id} class:list={[h.level === 3 && 'sub']} set:html={h.text}></a>)}
  </nav>

  <main class="wrap">
    {/* 靶：`id={TOP_ID}` 是文末那枚 `top` 指的地方；为什么落在这里、代价（不加平滑滚动）与判据（reading-check ⑤）
        全在上面 `TOP_ID` 那一格。⚠️ 这一格说明走的是"表达式里的注释"那条写法——它一个字节都不落进产物；
        HTML 注释会原样长字节（F6 那一轮就为这件事把一段模板注释删回去过）。 */}
    <header class="post-head reveal" id={TOP_ID}>
      <!-- 一行四读：路径（home · essays，能点）· 日期 · 字数。分隔点用字面 ` · `，
           与许可那一行／`.post-when` 同一个写法，不为它新写一条 CSS（`.tax-back` 那份声明住在
           mistwood.css，"标签行里的那一枚链接"就是它管的这一族——复用类，不复制声明，§17）。
           ⚠️ `.post-meta` 没有 `white-space:nowrap`（不像 `.sec-label` 那枚门牌）⇒ 窄屏它自然折行，
           这一行多了两枚词不会顶穿内容盒，也就不会重演 §11 那笔"裁掉的那半截正好是入口本身"。 -->
      <p class="post-meta">{crumb.map((c, i) => <>{`${i > 0 ? ' · ' : ''}`}<a class="tax-back" href={c.href}>{c.key}</a></>)} · {fmtDate(post.data.date)} · {words} 字</p>
      <h1 class="post-title">{post.data.title}</h1>
      {whenText && <p class="post-when">{whenText}</p>}
      {sub && <p class="post-sub">{sub}</p>}
      {hasTax && (
        <p class="chip-row">
          {catSlug && <a class="chip" href={`/categories/${catSlug}/`}>{cat}</a>}
          {tags.map(t => <a class="chip" href={`/tags/${taxSlug(t)}/`}>{t}</a>)}
        </p>
      )}
    </header>

    <!-- 正文走 §15 的排版白名单解析器，构建期落成静态 HTML -->
    <article class="post-body reveal" id="post-body" set:html={bodyHtml}></article>

    <!-- 正文配图灯箱：`hasShot` 为假 ⇒ 这一整块不存在（连那枚原生对话框的开标签都不落进产物，
         所以"数产物里有没有灯箱"这条判据读得到的是节点、不是这句说明——同 §14 那条"注释里的地址
         访客走不到"的口径，本卡实测过一次假红，说明里就不许写那个字面量）。
         在场的时候它也只有这一枚收起钮——大图与图注由 site.js 在第一次打开时造出来：
         那时才知道要点哪一张，而造早了就是一张没有 src 的空面（假位置，§12）。
         ⚠️ 收起钮是文字钮、吃 .post-act 那条声明（与盖章/专注同族，零新按钮形状）；
         Esc 与焦点陷阱由原生对话框的 showModal() 给，不是我们模仿的（§12:788 那条教训的反面：
         能点开的东西必须也能 Tab 到、也能按下去，触屏也收得回来）。 -->
    {hasShot && (
      <dialog id="lightbox" class="lightbox" aria-label="正文配图 · 放大看这一张">
        <button class="post-act lightbox-close" type="button">close · 收起这一张</button>
      </dialog>
    )}

    <!-- 盖章：分享＝把这一篇收下来。只落一行手记字，不画圆章（理由见 essay.css 与 §15） -->
    <div class="post-tail reveal">
      <button class="post-act" id="post-stamp" type="button">share · 把这一篇收进手记</button>
      <!-- 专注模式（§15 第九轮）：这一行里的第二枚，与盖章同源（共用 .post-act 那一条声明）。
           按下去撤两层：身后的雾（mask）+ 方向光落在正文上的部分——两条 CSS 与全部理由在 essay.css。
           ⚠️ `hidden` 是静态 HTML 就带着的：显形只由 site.js（打包的模块脚本）做，所以无 JS / 存储读不到
              时这一页与今天逐字节相同。故意**不**写进 Layout.astro 那段 `<script is:inline>`——那会牵动
              §16 第四类门禁"内联脚本同步落地五枚属性"的断言对象（§2.3 末"判定没搬进内联脚本"同一个理由）。
           ⚠️ 标签里不写机制（不写"撤雾"）：prefers-reduced-motion 下本来就没有雾可撤，写了就是 §12 那种假语义。
           aria-pressed 由脚本跟着状态翻；它是 <button type=button>，不是 href，所以 §12 死锚点那条管不到它。 -->
      <button class="post-act post-focus" id="post-focus" type="button" hidden aria-pressed="false">focus · 只看字</button>
      <p class="stamp-note" id="stamp-note" hidden></p>
      {/* 回到这一篇的开头（`card/topact`）：形状由 §15 第十一轮那一格写死——`.post-act` 那一族的文字控件、
          同一条声明、零新形状，不是那枚被裁掉的悬浮圆钮。裁决原文在规范里，这里不重审，只照它施工。
          为什么不坐在盖章／专注那一行里（那一行的 14px 横档是 `.post-focus` 那枚名字给的，借它＝假语义、
          新写一条＝新槽位）、为什么不吃 `#top` 那枚浏览器特判、为什么不加平滑滚动——全在上面 `TOP_ID` 那一格。
          `letter` 仍是 `.post-tail` 末位（F6 那一格的登记不动）；打印由 `base.css` 那条 `.post-tail{display:none}` 接住。 */}
      <p class="post-when">top · <a class="post-act" href={`#${TOP_ID}`}>回到这一篇的开头</a></p>
      {licenseSegs.length > 0 && (
        <p class="post-when">{licenseSegs.map((s, i) => <>
          {`${i > 0 ? ' · ' : ''}${s.pre}`}
          {s.url ? <a class="post-act" href={s.url} {...tabAttrs(s.url)}>{s.text}</a> : s.text}
        </>)}</p>
      )}
      {seriesSlug && (
        <p class="post-when">series · <a class="post-act" href={`/series/${seriesSlug}/`}>{seriesName}</a></p>
      )}
      {seriesNavSegs.length > 0 && (
        /* 系列内导航（F5）：挨着上面那一行"这一串叫什么、它的索引页在哪儿"，这一行是"这一串里的前一枚／后一枚"。
           两行都只在填了 series 时才存在，而下面那块 .post-nav 说的是全站日期邻居——两种语义三处都不混。 */
        <p class="post-when">in series · {seriesNavSegs.map((s, i) => <>{`${i > 0 ? ' · ' : ''}`}<a class="post-act" href={s.href}>{s.text}</a></>)}</p>
      )}
      {relatedSegs.length > 0 && (
        /* 相关的几篇（F4）：共享的真 token 枚数在前、平票保持目录顺序、至多 3 枚——三条都在
           `src/lib/related.js` 头上签字，这里只照它给的顺序画，不在此排第二遍（§15"顺序只住一处"）。
           枚数不印在行首：那一串 `N 篇` 与 `/series/` 页头那枚是同一族"数得出的真值"，可这一行的
           真值是**这几枚标题本身**，多印一个数就多一处"这行说了几篇"与"这行画了几篇"打架的地方。 */
        <p class="post-when">related · {relatedSegs.map((s, i) => <>{`${i > 0 ? ' · ' : ''}`}<a class="post-act" href={s.href}>{s.text}</a></>)}</p>
      )}
      {letterHref && (
        /* 写信回应（F6）：这一行是 `.post-tail` 的末位——"读完之后能做的最后一件事"。
           href 的三枚零件（地址、?subject=、编码过的篇名）全部在上面的 `letterHref` 那一行算完，
           这里不拼第二遍；地址那一个出处在 `src/data/site.js`。 */
        <p class="post-when">letter · <a class="post-act" href={letterHref}>写信回应这一篇</a></p>
      )}
    </div>

    {(prev || next) && (
      <nav class="post-nav reveal">
        {prev && <a href={`/essays/${prev.id}/`}><span>← prev</span>{prev.data.title}</a>}
        {next && <a class="next" href={`/essays/${next.id}/`}><span>next →</span>{next.data.title}</a>}
      </nav>
    )}

    <!-- 纸上一页脚（§19.5）：屏幕上 `display:none`，一个像素都不占（`base.css` 的打印段里才亮起来）。
         日期取这篇的 front matter `date`，与上面 `.post-meta` 同一个 `fmtDate`、同一个入参——
         打印当日是一个与内容无关的数，纸不许替访客说话（§16 那条"一个页面只许有一个构建时刻"同族）。 -->
    <footer class="print-foot">mistwood · essays · {fmtDate(post.data.date)}</footer>
  </main>
</Layout>
