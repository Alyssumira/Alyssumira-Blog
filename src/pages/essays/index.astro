---
/* `/essays/` ＝ 目录的**第 1 页**（本轮 `card/pagination`）。
   模板不在这里：整份目录的排版（密度尺／按年分节／门牌／翻页那一行）只有一份实现，
   住在 `src/components/EssayIndex.astro`，由这一页与 `src/pages/essays/page/[n].astro` 各画一页——
   ⚠️ 两处各写一份尺子就是"每页一把随页数漂移的假尺"的成因，所以这里连 `visiblePosts()` 都不调。
   第 1 页的地址**不带**页码（`/essays/`，不是 `/essays/page/1/`）：旧地址一个字节都不动，
   而 `/essays/page/<n>/` 只在真的翻页时才存在（今天三篇装在一页里 ⇒ 那一族一枚都不生成）。 */
import EssayIndex from '../../components/EssayIndex.astro';
import { visiblePosts } from '../../lib/posts.js';
const posts = await visiblePosts();
---
<EssayIndex page={1} posts={posts} />
