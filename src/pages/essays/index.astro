---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { fmtDate, root } from '../../lib/markdown.js';
import { readMinutes } from '../../lib/stats.js';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date - a.data.date);
const pad = n => String(n).padStart(2, '0');

/* 阅读时长的算法在 lib/stats.js：列表页与关于页的"总计"必须是同一把尺子，不能各算各的 */

/* 密度条：最近 12 个月每月几篇。空月份也画，一条刻度尺比三根柱子诚实。
   ⚠️ 2026-09-28 从 132×20 放大（美化建议 §2.2）：原尺寸实测读不出"哪几个月写过"，
   那就只是装饰档里一个看不清的点缀。现在高 60、每月一根、补月份刻度、当前月那根用 --moss 点亮。
   柱高仍旧**归一到峰值**（原口径，§15 已登记"给条子留一口气"），不改成按篇数绝对计——
   现在三篇分在三个月里，绝对高度和相对高度画出来是同一排等高，改了也不多说一个字。 */
const now = new Date();
const months = Array.from({ length: 12 }, (_, i) => {
  const d = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - 11 + i, 1));
  return { y: d.getUTCFullYear(), m: d.getUTCMonth() };
});
const perMonth = months.map(({ y, m }) => posts.filter(p => p.data.date.getUTCFullYear() === y && p.data.date.getUTCMonth() === m).length);
const peak = Math.max(1, ...perMonth);
const wrote = perMonth.filter(c => c).length;
const stamp = ({ y, m }) => `${y}.${pad(m + 1)}`;
const span = `${stamp(months[0])} → ${stamp(months[11])}`;

/* 按年分节；年份只写一次，行内就剩 MM.DD（Rachel Andrew 那套去噪法） */
const byYear = [];
for (const p of posts) {
  const y = String(p.data.date.getUTCFullYear());
  let g = byYear.find(b => b.y === y);
  if (!g) byYear.push(g = { y, items: [] });
  g.items.push(p);
}
let folio = 0;
---
<Layout title="文章 · mistwood" desc="经得起重读的东西。" here="essays">
  <main class="wrap">
    <header class="page-head reveal">
      <h1 class="page-title">文章</h1>
      <span class="sec-label">essays — <b>{pad(posts.length)}</b> →</span>
      <span class="density-wrap">
        <svg class="density" viewBox="0 0 300 60" width="300" height="60" role="img"
             aria-label={`近 12 个月（${span}）：${wrote} 个月有更新，共 ${posts.length} 篇`}>
          <line class="axis" x1="0" y1="46" x2="300" y2="46"/>
          {perMonth.map((c, i) => {
            const x = i * 26 + 5;                            /* 右移 5：第一个月份刻度的左半不能被 viewBox 切掉 */
            const h = c ? 6 + (c / peak) * 30 : 3;            /* 空月也留一根 3px 的刻度：尺子不能缺齿 */
            const lab = i % 3 === 0 || i === 11;              /* 每三个月一个月份刻度 + 当月必标 */
            return (
              <g class:list={{ now: i === 11 }}>
                <rect class:list={{ nil: !c }} x={x} y={46 - h} width="4" height={h} rx="1"></rect>
                {lab && <text x={x + 2} y="58">{pad(months[i].m + 1)}</text>}
              </g>
            );
          })}
        </svg>
        <span class="density-cap">近 12 个月 · {span}</span>
      </span>
    </header>

    {byYear.map(g => (
      <section class="year-block reveal">
        <h2 class="year-mark">{g.y}</h2>
        <ol class="essay-index">
          {g.items.map(p => {
            const n = ++folio;
            const d = p.data.date;
            return (
              <li>
                <a class="row" href={`/essays/${p.id}/`} data-slug={p.id}>
                  <span class="folio">{pad(n)}</span>
                  {p.data.cover ? <span class="cover"><img src={root(p.data.cover)} alt="" loading="lazy"></span> : null}
                  <span class="row-main">
                    <h3>{p.data.title}</h3>
                    <p class="row-ex">{p.data.excerpt}</p>
                  </span>
                  <span class="row-side">
                    <time>{fmtDate(d).slice(5)}</time>
                    <span class="row-min">{readMinutes(p.body)} min</span>
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </main>
</Layout>
