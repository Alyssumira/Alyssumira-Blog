---
/* Seo.astro —— 站内结构化数据（JSON-LD）唯一的出处。由 Layout 在 <head> 里挂一次，六页都有。

   三条纪律（都是本项目的口味，不是通用最佳实践）：
   ① **地址一律从 Astro.site 派生**（`at()` 那一行），这里不出现任何一枚裸域名。占位域名与真域名的开关在
      `astro.config.mjs` 的 SITE，改那一处全站跟着变；本文件抄一份就等于给 §16 那笔"绝对地址 N 处"的账再添一处真值。
   ② **拿不到的字段整块不写，不许回落**。dateModified 只来自 `revised.js`（判据源是 git 里最后一次改动型提交），
      git 问不到 ⇒ 这一键不存在。写成 `dateModified: date` 是最危险的假语境：机器会读成"这篇后来改过"，
      而盘上从来没有那次改动（§12 禁假数字那一族的近亲）。少一项不是错，多一项才是。
   ③ **一个 @id / URL 都不许指向不存在的页面**（§12 死锚点在结构化数据上的同族）：
      节点只落在 `/`、`/about/`、`/essays/`、`/og.png` 与本页 canonical 上，这几样都在 dist/ 里查得到。
      同理，`interactionStatistic` / 评论数 / 阅读量 / 点赞数一枚都不写——本站纯静态、没有服务端、没有统计脚本，
      拿不到的东西不进 JSON-LD（§12"编一个访问量"那条管到这里）。 */
import { AUTHOR } from '../data/site.js';
import { publishISO, revisedOn } from '../lib/revised.js';
import { crumbTrail } from '../lib/nav.js';

const { siteName, canonical, ogImage, title, desc, type = 'website', here = '', revised, date } = Astro.props;

/* 唯一的取址口径：相对路径 + Astro.site。canonical / ogImage 是 Layout 算好的那两枚 URL 对象，传进来用，不在这儿重算 */
const at = p => new URL(p, Astro.site).href;
const isArticle = type === 'article';

const siteId = at('/') + '#website';
const personId = at('/about/') + '#author';

/* 谁在写这个站。`url` 指向 /about/（真实页面）；`sameAs` 空着，理由见 src/data/site.js 那枚 AUTHOR 的注释 */
const person = {
  '@type': 'Person',
  '@id': personId,
  name: AUTHOR,
  url: at('/about/'),
};

/* 站点身份：每个页面都带一份，靠 @id 让消费方知道"这是同一个东西"，不是六份不同的站 */
const website = {
  '@type': 'WebSite',
  '@id': siteId,
  name: siteName,
  url: at('/'),
  inLanguage: 'zh-CN',
  publisher: { '@id': personId },
};

/* 详情页那一篇。⚠️ headline 用的是页题（与 <title> / og:title 同一个值），尾巴上带着 ' · mistwood'：
   那是 [slug].astro 定的页题形状，本卡不为 JSON-LD 再要一枚裸标题当 prop——同一篇稿子两份题名，迟早对不上 */
const posting = isArticle ? {
  '@type': 'BlogPosting',
  '@id': canonical.href + '#article',
  url: canonical.href,
  headline: title,
  description: desc,
  image: ogImage.href,
  inLanguage: 'zh-CN',
  isPartOf: { '@id': siteId },
  author: { '@id': personId },
  publisher: { '@id': personId },
  datePublished: publishISO(date) || undefined,
  /* 这一枚就是"git 问得到才写"的那一格：走的是页面上那行「改于」的同一把尺子（revisedOn 兼着 undefined 闸门
     与"同日或更早不算改"的判定）。两处两种判定＝迟早让人看不懂哪个是真的；机器少读一枚 dateModified 不是读错，
     读着一枚和 datePublished 一模一样的数才是噪音。 */
  dateModified: revisedOn(date, revised) || undefined,
} : null;

/* 面包屑：中段从 `src/lib/nav.js` 那一枚导航表里取（同一份真值，不在这儿抄第二份名字，也不在组件里
   重拼一遍——第六轮 `card/navcrumb` 把表搬出 `Layout` 之后，屏幕上那行可见面包屑吃的是同一个函数），
   末节是本页自己。只有首页一级（404 那种"这里没有页面"的地址）⇒ 一条两级的链都拼不出来，整块不写 */
const trail = crumbTrail(here).map(c => ({ name: c.name, item: at(c.href) }));
if (isArticle) trail.push({ name: title, item: canonical.href });
const crumb = trail.length > 1 ? {
  '@type': 'BreadcrumbList',
  '@id': canonical.href + '#breadcrumb',
  itemListElement: trail.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, item: t.item })),
} : null;

const graph = [website, person, posting, crumb].filter(Boolean);
/* 把 JSON 里的左尖括号换成 ‹\u003c› 那种六字符转义：解析回来还是同一个字符，但它挡住"页题里出现脚本结束标签
   的字面量"时把这一段提前关掉——解析器认字面量不认语义。合法 JSON 才谈得上被消费，所以这一步跑完还要拿
   JSON.parse 复验一次（验收第 4 条），别只信构建绿。 */
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<script type="application/ld+json" set:html={ld}></script>
