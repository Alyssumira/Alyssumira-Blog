---
/* 一行目录（§15 / §9 的 `.row`）：`编号 · 标题 · 摘要 · MM.DD · N min`，有封面时挂 92px 缩略图。
   为什么要有这一枚组件：分类页与标签页列的都是"同一批稿子的一个子集"，
   那一行的形状、日期的写法、分钟数的尺子都必须和 /essays/ 说的同一句话——
   在两处各写一遍模板，下一轮必然有一处先改（本项目的"派生字段铁律"同一个口味）。
   ⚠️ 只给分类/标签两页用；/essays/ 与首页那两处**没有**搬过来：
      它们各自带密度条、按年分节、限宽 720 的错落，几何是 §15 逐格登记过的实测读数，
      搬一次就等于把已签字的版式重新过一遍风险。这里复用只是"同一门语言说第二遍"。 */
import { fmtDate, root } from '../lib/markdown.js';
import { readMinutes } from '../lib/stats.js';

const { post, n } = Astro.props;
const pad = v => String(v).padStart(2, '0');
const d = post.data.date;
---
<li>
  <a class="row" href={`/essays/${post.id}/`} data-slug={post.id}>
    <span class="folio">{pad(n)}</span>
    {post.data.cover ? <span class="cover"><img src={root(post.data.cover)} alt="" loading="lazy"></span> : null}
    <span class="row-main">
      <h3>{post.data.title}</h3>
      <p class="row-ex">{post.data.excerpt}</p>
    </span>
    <span class="row-side">
      <time>{fmtDate(d).slice(5)}</time>
      <span class="row-min">{readMinutes(post.body)} min</span>
    </span>
  </a>
</li>
