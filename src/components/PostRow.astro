---
/* 一行目录（§15 / §9 的 `.row`）：`编号 · 标题 · 摘要 · MM.DD · N min`，有封面时挂 92px 缩略图。
   为什么要有这一枚组件：分类页与标签页列的都是"同一批稿子的一个子集"，
   那一行的形状、日期的写法、分钟数的尺子都必须和 /essays/ 说的同一句话——
   在两处各写一遍模板，下一轮必然有一处先改（本项目的"派生字段铁律"同一个口味）。
   ⚠️ 只给分类/标签两页用；/essays/ 与首页那两处**没有**搬过来：
      它们各自带密度条、按年分节、限宽 720 的错落，几何是 §15 逐格登记过的实测读数，
      搬一次就等于把已签字的版式重新过一遍风险。这里复用只是"同一门语言说第二遍"。
   ⚠️ `card/imgpipe`（2026-09-30）给封面那枚 `<img>` 补了 `width`/`height`/`decoding`，两句口径：
      ① **两枚属性不上屏**——`mistwood.css:504` 写的是 `.cover img{ position:absolute; inset:0; width:100%; height:100% }`，
         盒子由 `.row .cover{ width:92px; aspect-ratio:4/3 }`（:493）定，`card/hairline` 量的那枚 92×69 一个字不动；
      ② 地址那一枚 `coverSrc()` 在这一行里**调了两次**，不是为了省事少一行变量，是因为第 ④ 格把那枚字面形状
         钉住了（`src={coverSrc(post.data.cover)}` 原文比对，它判的是"cover 先过那一枚退路、再经 root() 才进 src"）——
         提成局部变量会让绊线假红。两次都是纯函数、结果同缓存，代价是零。
      ⚠️ 2026-10-01 晚这一行**从"有封面才画"改成"永远画"**：`cover` 空着不再整块不出现，而是退回站点默认那张
         （`src/data/site.js` 的 `DEFAULT_COVER`；退路只有一枚函数 `src/lib/covers.js`）。§13 那格原来那句
         "空着 ⇒ 列表页不画缩略位"同日改判，账在 runbook §3.13 第 ⑲ 格。 */
import { fmtDate } from '../lib/markdown.js';
import { coverSrc } from '../lib/covers.js';
import { intrinsicProps } from '../lib/image-dims.js';
import { readMinutes } from '../lib/stats.js';

const { post, n } = Astro.props;
const pad = v => String(v).padStart(2, '0');
const d = post.data.date;
---
<li>
  <a class="row" href={`/essays/${post.id}/`} data-slug={post.id}>
    <span class="folio">{pad(n)}</span>
    <span class="cover"><img src={coverSrc(post.data.cover)} {...intrinsicProps(coverSrc(post.data.cover))} alt="" loading="lazy" decoding="async"></span>
    <span class="row-main">
      <h3>{post.data.title}</h3>
      <p class="row-ex">{post.data.excerpt}</p>
    </span>
    <span class="row-side">
      <time>{fmtDate(d).slice(5)}</time>
      <span class="row-min">{readMinutes(post.body)} min</span>
    </span>
  </a>
</li>
