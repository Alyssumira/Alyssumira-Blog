---
import Layout from '../layouts/Layout.astro';
import SearchEntry from './SearchEntry.astro';
import { fmtDate } from '../lib/markdown.js';
import { coverSrc } from '../lib/covers.js';
import { intrinsicProps } from '../lib/image-dims.js';
import { readMinutes, bodyLen, wordRuler, yearRings } from '../lib/stats.js';
import { essaysPerPage, pageRanges, pageHref } from '../lib/pagination.js';
/* 三族索引页的可见入口（F2 `card/f2entries`）用的那三份分组函数——**就是 `/categories/`、`/tags/`、`/series/`
   三页自己用的那三份**（`groupBy(posts, categoryOf)` / `tagGroups(posts)` / `seriesGroups(posts)`，
   `seriesGroups` 住在 `src/lib/series.js`，它是 `taxonomy.js` 那份 `groupMany` 的一个特例）。
   ⚠️ 这里不 import `posts.js`、也不写第二种"谁算这一族的一篇"：判家族非空与判清单非空必须是同一份实现，
      否则"索引页说有三篇、目录页说一枚都不画"这种分叉只能靠人肉发现（§16 记过这一族）。 */
import { categoryOf, groupBy, tagGroups } from '../lib/taxonomy.js';
import { seriesGroups } from '../lib/series.js';

/* 草稿不在这一页（也不在详情页、订阅源、关于页那几个数里）——filter 只住在 lib/posts.js 那一份。
   顺序：置顶在最前，其余按日期倒序；下面的"按年分节"与 folio 都吃这个数组的顺序，
   ⚠️ 所以置顶那篇会在它自己那一年的最前面、门牌仍旧连续（folio 只跟着渲染顺序加，不参与排序）。
   ⚠️ 本轮 `card/pagination` 起这一份模板**两处用**（`src/pages/essays/index.astro` 画第 1 页、
      `src/pages/essays/page/[n].astro` 画第 2 页起），所以密度尺、`sec-label` 那个数、按年分节、门牌
      都只有一份实现——"每页各画一把尺子"那种随页数漂移的假尺从形状上就画不出来（§15 那一格）。
   ⚠️ 名单由**调用方交进来**（`posts` prop），这一份模板不自己去拿集合：
      ① 取集合的那一步只许住在 `src/lib/posts.js`（`tools/taxonomy-check.mjs` 的 ①② 两格钉着），
         模板里再调一次就是把"谁喂这一页"变成两处真值；
      ② 两枚调用者交的都是 `visiblePosts()`（滤草稿＋滤不列入）。谁哪天把 `publishedPosts()` 那一枚
         "建路"用的读函数喂进来，不列入的稿子就整篇回到目录里——那一格的红由 taxonomy-check 第②格点名。 */
const { page = 1, posts } = Astro.props;
if (!Array.isArray(posts)) {
  throw new Error(`EssayIndex.astro：posts prop 收到 "${posts}"——整份目录的名单必须由调用方交进来（src/pages/essays/index.astro 与 page/[n].astro 那两枚 visiblePosts() 的结果）。`
    + '模板自己不调 getCollection，也不许退回"空着就当没有稿子"：那会画出一张一行都没有的活壳（§12）。');
}
/* 整份名单只切一次：`at` 交出这一页在**整份数组**里的下标区间（左闭右开），
   下面那把尺子吃 `posts`（整份），行与分节吃 `items`（本页）。两件事分得开，页码才不许掺进尺子。 */
const ranges = pageRanges(posts.length, essaysPerPage());
const at = ranges[page - 1];
if (!at) {
  /* 越界那一页不是"空页"，是**不该存在的路由**：`getStaticPaths` 只交回 ranges 里的那些页码，
     走到这里说明两处的页码算分了（或者有人手写了一枚 props）。宁可在构建期响，
     也不许生成一份"页面在、一行都没有"的产物（§12 那条"关掉之后不留活壳"的产物级版）。 */
  throw new Error(`EssayIndex.astro：第 ${page} 页不在 ${posts.length} 篇 ÷ 每页 ${essaysPerPage()} 行切出来的 ${ranges.length} 页里。`
    + '正确落点是让那一页根本不构建（src/pages/essays/page/[n].astro 的 getStaticPaths 只交 ranges.slice(1)），'
    + '不是把它画成一张空目录。');
}
const items = posts.slice(at.from, at.to);
const pad = n => String(n).padStart(2, '0');
/* 页题只给非首页加一句"第 N 页"：第 1 页那个 `<title>` 与旧产物逐字节相同（它是 og:title 与 JSON-LD 的名字来源，
   也是"改前改后第 1 页不许变样"那一格读到的字节之一）。 */
const pageTitle = page === 1 ? '文章 · mistwood' : `文章 · 第 ${page} 页 · mistwood`;

/* 阅读时长的算法在 lib/stats.js：列表页与关于页的"总计"必须是同一把尺子，不能各算各的 */

/* 密度尺：最近 12 个月每月几篇。空月份也画刻度，一条刻度尺比三根柱子诚实。
   ⚠️ 2026-09-28 从 132×20 放大（美化建议 §2.2）：原尺寸实测读不出"哪几个月写过"，那就只是装饰档里一个看不清的点缀。
   ⚠️ 2026-09-29 尺身从 SVG 换成**全宽 HTML**：拉宽 viewBox 会等比放大整张画（柱、字、轴线一起长），机制与三档实测在 §15 那一格。
   柱高仍旧**归一到峰值**（原口径，§15 已登记"给条子留一口气"），不改成按篇数绝对计——
   今天三篇全在 2026.09 那一格里（i=11，c=3 ⇒ h=36），其余 11 格各是一枚 3px 的空月刻度：绝对与相对画出来是同一根柱，改了也不多说一个字。
   ⚠️ 本轮 `card/pagination` 给它钉死一条口径：**这一把尺读的是整份 `posts`，不是本页的 `items`**。
   每页各画一把尺子＝一把随页数漂移的假尺（第 2 页的峰值不可能是"最近 12 个月的峰值"），所以
   `perMonth`／`peak`／`wrote`／`span` 与那句 `共 N 篇` 全部只吃整份名单，`sec-label` 那个数也是。
   判它读得到读不到的方式不在注释里，在产物里：`tools/pagination-check.mjs` 逐页比那一排 `<span class="density">`
   的**字节**（各页必须逐位相同）与 `（{wrote} 个月有更新，共 N 篇）`／`essays — <b>NN</b>` 里的 N ⇄ 整份名单枚数。 */
const now = new Date();
const months = Array.from({ length: 12 }, (_, i) => {
  const d = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - 11 + i, 1));
  return { y: d.getUTCFullYear(), m: d.getUTCMonth() };
});
const perMonth = months.map(({ y, m }) => posts.filter(p => p.data.date.getUTCFullYear() === y && p.data.date.getUTCMonth() === m).length);
const peak = Math.max(1, ...perMonth);
const wrote = perMonth.filter(c => c).length;
const stamp = ({ y, m }) => `${y}.${pad(m + 1)}`;
const span = `${stamp(months[0])} → ${stamp(months[11])}`;

/* 写作年轮（三轮 §1.1 横条版；母题指认与降级谱在 §13b、规格在 §15、打印在 §19.1）：
   过去一年每天一格，写过稿的日子按当天的字数上深浅，按月轻轻分段。
   ⚠️ 窗口终点＝这批稿子里最新的那一天，不是构建时刻。终点若吃 `new Date()`，这份产物每天多改一次
   字节，而"改前改后逐字节对账"是现役验收尺（§16）；上面那把 12 月尺按月份滑、只在月初变，
   这一把按天滑、每天都会变，所以它向数据要终点。格数与区间都由日历算（Date.UTC 自带 2 月 29 日），
   代码里不写 365/366 那类常量——与 `stats.js` 的 `yearArc()`、`lifegrid.js` 的 `lifeField()` 同一句话。
   ⚠️ 深浅走 `--moss-ink` 一枚墨的 alpha 档，不走提案写的 `--moss-ink`→`--moss` 明度轴：夜林那一档
   这两枚令牌是同一个值（`base.css:75` 与 `:77` 写的是同一枚色，照 §13b 那格的口径不在注释里抄它的字面量），
   轴的量程是零，两篇字数差三倍的格子
   会在夜里画成同一枚色。alpha 那两档（25% 地板／峰值 100%）是画幅，比例尺仍旧只由数据定：
   深浅 ＝ 当天字数 ÷ 这一年里最重的那一天。空格照 `.density .tick.nil` 那一对现成值——尺子不能缺齿。 */
const DAY_MS = 86400000;
const ringEnd = new Date(Math.max(...posts.map(p => p.data.date.getTime())));
const ringStartTs = Date.UTC(ringEnd.getUTCFullYear() - 1, ringEnd.getUTCMonth(), ringEnd.getUTCDate() + 1);
const ringEndTs = Date.UTC(ringEnd.getUTCFullYear(), ringEnd.getUTCMonth(), ringEnd.getUTCDate());
const ringCells = Math.round((ringEndTs - ringStartTs) / DAY_MS) + 1;
const dayWords = new Map();
for (const p of posts) {
  const t = Math.floor(p.data.date.getTime() / DAY_MS) * DAY_MS;
  dayWords.set(t, (dayWords.get(t) || 0) + bodyLen(p.body));
}
const ringPeak = Math.max(1, ...dayWords.values());
const ringMonths = [];
for (let i = 0; i < ringCells; i++) {
  const t = ringStartTs + i * DAY_MS;
  const d = new Date(t);
  const key = d.getUTCFullYear() * 100 + d.getUTCMonth();
  let g = ringMonths.find(m => m.key === key);
  if (!g) ringMonths.push(g = { key, days: [] });
  g.days.push({ t, w: dayWords.get(t) || 0 });
}
/* ⚠️ 图例那句"几天写过"数的是**这一片窗口里亮着的格子**，不是 dayWords.size：
   一年前的旧稿照样在 dayWords 里，但它那一格不在画幅里——拿 Map 的枚数去讲这片格子就是报假数（§12）。 */
const ringWrote = ringMonths.reduce((n, g) => n + g.days.filter(c => c.w).length, 0);

/* 每行字数尺（三轮 §1.2；§9 那一格与 12 月刻度尺的"同族两档"裁决、§12 那枚否决的药方都签在规范）：
   条长 ＝ 这一篇的字数 ÷ 这批稿子里最长的那一篇。峰值归一，没有一毫米来自"1 min = 20px"那种常数。
   ⚠️ 分母读**整份 `posts`**、不读本页 `items`——与上面那把尺同一条口径：一把随页数漂移的是假尺。
   ⚠️ 字数向 `stats.js` 的 `bodyLen()` 要（`cjkCount` ＋ `latinWords` 那一对，与 `readMinutes`、
      关于页那个总数同一把尺），这一页不自己数；画幅走 `em`（宿栏 12px 的一枚字高为上界、
      三分之一为下界），不新增一枚 px。它是旁边那枚 `N min` 的图形，不是第二份真值。 */
/* ⚠️ 2026-10-02（三轮 §1.4，`v8b2/profile`）这两行整对搬进 `src/lib/stats.js` 的 `wordRuler()`：
   关于页那片散点河是同一把字数尺的第二个消费者，两处各写一份归一化就是 §17 点名的第二处真值。
   搬的只是位置——峰值归一、画幅 0.35em～1em、分母读整份 `posts` 这三条口径一个字没改，
   `tickEm(len)` 的调用点与产物里那几串 `…em` 都不动（这一条改前改后各取一份产物对过）。 */
const tickEm = wordRuler(posts);

/* 按年分节；年份只写一次，行内就剩 MM.DD（Rachel Andrew 那套去噪法）
   ⚠️ 分页之后这一格分的是**本页那几行**（`items`），不是整份名单：同一年的行被页界切开时，两页各写一次那一年
      的年标——那是"这一页里有这几行"的事实，不是第二把尺。尺子（密度尺／`共 N 篇`／`sec-label` 那个数）
      仍旧只读整份 `posts`，一页一把尺子的形状在这里画不出来。 */
const byYear = [];
for (const p of items) {
  const y = String(p.data.date.getUTCFullYear());
  let g = byYear.find(b => b.y === y);
  if (!g) byYear.push(g = { y, items: [] });
  g.items.push(p);
}

/* ── 同心环归档（四轮 §4-3，落的就是这一只尺架预登记的那格升级位）──
   一圈＝一年、圈上的点＝那一年写过的篇数；每一圈是一枚真链接，跳到那一年那一节。
   家族指认：它和 `stats.js` 的 `yearArc()`、`about.astro` 的 `.yearring`／`.w-dot` 同族（§13b 年轮弧那一族），
   画法照 `.w-dot` 那一族走 SVG `<circle>`，一枚 `border-radius` 都不写（圆角那 32 枚／12 种在 gap-check
   的梯子上枚数冻结，多一枚新写法就红）。几何、退档判据与两条理由都只住在 `yearRings()` 那一份里
   （§17 一处真值：模板这一侧不再判第二次"够不够两枚年"，判据写两处早晚有一处分叉）。
   ⚠️ 与横条**不同尺**（这句是要入账的判词，不是注释里的闲话）：横条数的是**日粒度**——一年每天一格、
      深浅＝当天字数，它的通道是连续量（alpha），图例报的是"几天写过"；环数的是**年与篇**——一圈一年、
      一点一篇，它的通道是离散计数（点数），图例报的是"几几年、几篇"。两枚读同一份 `posts` 的两个粒度，
      一枚不许替另一枚复核，也不合成一把尺：把横条的年份汇总就是环，把环拆到日就是横条，
      两句话都是同一份日期数据的两种画法，不是两份真值。
   ⚠️ 分母读**整份 `posts`**、不读本页 `items`：与上面那两把尺同一条纪律（一页一把尺子＝随页数漂的假尺）。
      代价是环与下面的分节可能不同页 ⇒ 落点由 `ringTo()` 现算，见那一格。 */
const rings = yearRings(posts);
/* 每一圈跳去哪：**本页有那一年 ⇒ 片段 `#y<YYYY>`**（靶就是下面那一枚 `.year-block` 的 id）；
   本页没有那一年 ⇒ 指到"那一年在整份名单里第一次出现的那一行"所在的页，仍旧吃同一枚片段。
   ⚠️ 本页优先那一侧不是顺手：一年的行被页界切开时两页各写一次那一年（上面 `byYear` 那一格签过），
      两页都读得到同一枚 `#y<YYYY>` 的靶；若不分本页外页就一律指首页，第二页上的圈会绕回第一页去跳
      一跳就在眼前的那一节——那才是真锚点旁的假动作。
   ⚠️ 这一枚判据的存在理由就是 §12 死锚点禁令的产物级版：**一页上出现的具名片段必须在同一份产物里
      真有一枚同值 id**。不分页那一态（今天这一态，`ranges.length === 1`）每条环都落 `#y…`，
      `pageHref()` 一个字节都不拼；分页那态才跨页，而跨页那一串 `isPageHref()` 认不出来
      （它钉的是 `^/essays/page/<n>/$` 整串），所以 `pagination-check` 那一族翻页账不会被这枚新链接扰动，
      跨页那一半由 `tools/ring-check.mjs` 第 ③ 格拿产物逐枚验（尺子不吃模板自己的承诺）。 */
const ringTo = y => {
  if (byYear.some(g => Number(g.y) === y)) return `#y${y}`;
  const idx = posts.findIndex(p => p.data.date.getUTCFullYear() === y);
  const pg = ranges.findIndex(r => idx >= r.from && idx < r.to) + 1;
  return pg === page ? `#y${y}` : `${pageHref(pg)}#y${y}`;
};

/* ── 密度自适应的目录行（一轮 §B1，本卡）：两档都是**离散**的构建期档，不是连续缩放 ──
   ⚠️ 阈值吃**整份 `posts`**、不吃本页 `items`：与上面那两把尺同一条口径（一页一把尺子＝随页数漂的假尺）。
      拿本页数的话这一档今天是死的——每页 3 行永远 ≤6，`compact` 那一档一次都切不过来，
      而一枚永远读不到的判据不该签进产物。
   ⚠️ 落点是 `<ol class="essay-index">`，不是提案字面写的 `<body>`／也不是 `<main>`，三条理由：
      ① `tools/pagination-check.mjs` 第 ③ 格钉死了 `<main class="wrap"><header class="page-head reveal head-essays">`
         这一整串开口字节（那枚 `head-essays` 是 §2.1 雾线族的宿主锚）——往 `<main>` 上加属性就是
         让一把已签字的尺去读一枚新东西，本卡不许动它；
      ② 这一档管的只有目录行，而 `.row` 全部住在 `<ol>` 里 ⇒ 宿主选窄不选宽
         （与 §3.4 那格"可继承的声明开在哪一层"同一条判据）；
      ③ `<body>` 住在 `src/layouts/Layout.astro`，全站九页共用它——为 /essays/ 的一档行距去改全站地板，
         代价是每一页的字节都动，收益是零。
   ⚠️ 两档的值（都是签过字的，一枚新 px 都不许多写）：
      · sparse ＝ 盘上现值，一条声明都不写：`.row` 上下内垫 26px（在册 X）＋ 摘要两行（`line-clamp:2`／`min-height:3.4em`）；
      · compact ＝ `.row` 上下内垫收到 20px——**这一枚不是新值**，它就是 `@media (max-width:720px)` 里 `.row`
        已经在册的那枚 20px（同元素·同属性·同档），本轮只是让它在宽屏的 compact 档也说话；
        摘要收到一行走 `-webkit-line-clamp:1` ＋ `min-height:1.7em`（＝摘要自己那一行行盒 15px × 1.7 的整数倍），
        `line-clamp` 与 `em` 都不在 `tools/gap-check.mjs` 的拆值口径里 ⇒ 零枚新固定 px。
      两档之间没有中间态：阈值只比一次大小，CSS 只有两条规则，没有 `clamp()`／没有随宽度连续收。
   ⚠️ 整行仍旧可点：这一档只改 `.row` 自己的上下内垫与摘要占的行数，`<a class="row">` 的 DOM 与
      `padding` 的横向值一个字节没动 ⇒ §8.3 那枚"悬停目录行"的铺面（`.row::before` 走 `top/bottom:0`）
      跟着新行高自己长，不需要也不许为它开第二档。 */
const DENSITY_COMPACT_AFTER = 6;   /* 提案 §B1 的阈值：文章数 ≤6 保持大留白，>6 自动紧一档 */
const density = posts.length > DENSITY_COMPACT_AFTER ? 'compact' : 'sparse';

/* ── 季度分节（一轮 §B2，本卡）：某一年在**整份名单**里 ≥12 篇时，那一年内部再出一道更轻的分节 ──
   三条口径：
   ① 判据数的是整份 `posts` 里那一年的枚数（`totalByYear`），不是本页那几行——与上面那枚 density 同一个理由：
      每页 3 行时"本页某年 ≥12"是一枚永远不成立的死判据。
   ② 分节只长在**已有的那只年块里**（`.year-block` → 若干 `<ol class="essay-index">`），
      不长第三套时间分节系统：页头那只尺架里已经有两把尺（12 月刻度尺／写作年轮横条，§15 与 §13b），
      按年分节是这一块的骨架，季度只是同一副骨架的**下一层**——一条 `--line` 发丝线 ＋ 一枚 `--ink-3` 的名字，
      零背景、零新材质、零枚新垂直槽位（线走 `border-top`、名走 `line-height` 自己那半档行距，两枚都不在拆值口径里）。
   ③ 名字走全站那层"拉丁小写标签"（§7 与 §12 禁大写标签那一族）：`q1`…`q4`，
      与它上面那枚年标（`2026`，IBM Plex Mono）同一副嗓子；季度**由月份算出来**（`getUTCMonth()` ÷ 3 向下取整），
      不替作者起名、不编第二个数——同一份日期数据在这一页只多画一道"归属"，不多画一份统计。
   ⚠️ 切法用**连续段**、不用上面 `byYear` 那枚 `.find()` 的同名合并：行序＝名单序是硬口径
      （`tools/pagination-check.mjs` 第②格钉"各页的行按页序拼起来 ⇄ 整份名单逐枚相同"），
      置顶那篇会带着它自己那一季度的几行走在最前面，同名合并会把后面的行提上来 ⇒ 那一格就红了。
      代价是同一年的同一季度理论上可能出现第二段（只有置顶跨季度时读得出来），那是"这一段属于哪几个月"的事实。 */
const QUARTER_MIN = 12;   /* 提案 §B2 的阈值：某年 ≥12 篇才分季度，一年三四篇时画它就是噪音 */
const totalByYear = new Map();
for (const p of posts) {
  const y = String(p.data.date.getUTCFullYear());
  totalByYear.set(y, (totalByYear.get(y) || 0) + 1);
}
const quarterOf = p => Math.floor(p.data.date.getUTCMonth() / 3) + 1;
/* 一年那几行摊成"要画的块"：整年不到 12 篇 ⇒ 一枚无名块（就是今天的样子，一个字节都不多）；
   够了 ⇒ 按连续季度切成几枚带名的块。`q: 0` 是"这一枚块没有季度名"那个哨兵，不是第一季度。 */
function chunksOf(g) {
  if ((totalByYear.get(g.y) || 0) < QUARTER_MIN) return [{ q: 0, items: g.items }];
  const out = [];
  for (const p of g.items) {
    const q = quarterOf(p);
    if (!out.length || out[out.length - 1].q !== q) out.push({ q, items: [] });
    out[out.length - 1].items.push(p);
  }
  return out;
}
/* 门牌是**整份目录**里第几行，不是这一页第几行 ⇒ 起点是本页在全局的偏移，跨页连号（01 02 03 | 04 05）。
   与跨年分节连号同一条口径，判据在 `tools/runtime-check.mjs` 的门牌对账那一格（本轮已扩到跨页）。 */
let folio = at.from;

/* 三族索引页的可见入口（F2 `card/f2entries`，规格在规范 §9 那一格）。三句话：
   ① **只向 shipped 的那份分组要数**：`posts` 是两枚路由交进来的 `visiblePosts()` 结果（口径与三族索引页
      自己用的那一条 filter 相同；模板不取集合，`tools/taxonomy-check.mjs` 第②格钉着这件事），
      家族成员因此是"数出来的"，不是这一页再 filter 一遍。
   ② **没填就不出现，而且是字节级的**：一族为空 ⇒ 那一枚锚不落；三族全空 ⇒ 整行不进产物。
      今天三篇稿子的 `category`／`tags`／`series` 三行都空着，所以这一格的现读数是 **0 枚入口**，
      `/essays/` 与改动前逐字节相同（§12 禁"预留一个只会显示空缺的位置"，`display:none` 那种空壳也不算过关）。
   ③ **不替作者起名字**：三个词是族的**入口名**（分类／标签／系列），不是分类名——分类名照样只来自 front matter。
   href 一律站内相对 ⇒ 绝对地址那笔账（产物里 200 处占位域名）一枚不涨。 */
const browse = [
  { label: '分类', at: '/categories/', n: groupBy(posts, categoryOf).length },
  { label: '标签', at: '/tags/', n: tagGroups(posts).length },
  { label: '系列', at: '/series/', n: seriesGroups(posts).length },
].filter(f => f.n > 0);
---
<Layout title={pageTitle} desc="经得起重读的东西。" here="essays">
  <main class="wrap">
    <header class="page-head reveal head-essays">
      <h1 class="page-title">文章</h1>
      {/* 扉页那一行现在要能承一块玻璃面板 ⇒ tag 从 `<span>` 换成 `<div>`（内容模型合法、`display:block`
          由 `.page-head .sec-label` 那条既有声明给，版面逐位不变）；理由全文在 SearchEntry.astro 头上。 */}
      <div class="sec-label">essays — <b>{pad(posts.length)}</b> →<SearchEntry /></div>
      <span class="density-wrap">
        {/* 尺身是 HTML 不是 SVG：`.density` 的宽度换成 100% 在 SVG 上不是"换个分母"，是整张画等比放大（10px 标签随视口漂、带高按 5:1 长到 224px），理由与三档实测读数在 §15 那一格。横向映射 x=i*26+5（300 用户单位内）→ left=i/11*100%（全宽内）；柱宽 4、柱高 6+(c/peak)*30、空月 3、带高 60、轴在 y=46、标签 10px mono .06em 一个都没改。 */}
        <span class="density" aria-hidden="true">
          {perMonth.map((c, i) => {
            const h = c ? 6 + (c / peak) * 30 : 3;            /* 空月也留一根 3px 的刻度：尺子不能缺齿 */
            const lab = i % 3 === 0 || i === 11;              /* 每三个月一个月份刻度 + 当月必标 */
            const brch = i === 0 || months[i - 1].y !== months[i].y;   /* 带年的只有两格：窗口起点 i=0，与窗口里的年份边界（今天 i=3＝2026.01） */
            const pos = `left:calc(${i} / 11 * 100%)`;        /* 柱心落位、translateX(-50) 居中 ⇒ 首尾各探出 2px 是刻意的：轴线必须与 .essay-index 同宽 */
            return (
              <>
                <span class:list={['tick', { nil: !c, now: i === 11 }]} style={`${pos};height:${h}px`}></span>
                {/* 首尾两枚标签换成贴栏缘（head=左缘对齐、tail=右缘对齐，样式在 mistwood.css 的 .d-lab.head/.d-lab.tail）：
                    标签是文字，居中会让它探出栏左缘、切断全站那条左对齐线；柱仍居中，因为柱心是数据位置。key 顺序 head/tail 排在 now 前面是刻意的——产物里那枚 class 串要读成 `d-lab tail now`。 */}
                {lab && <span class:list={['d-lab', { head: i === 0, tail: i === perMonth.length - 1, now: i === 11 }]} style={pos}>{brch ? <><span class="full">{stamp(months[i])}</span><span class="short">{pad(months[i].m + 1)}</span></> : pad(months[i].m + 1)}</span>}
              </>
            );
          })}
        </span>
        <span class="density-cap">近 12 个月 · {span}（{wrote} 个月有更新，共 {posts.length} 篇）</span>   {/* 尺身 aria-hidden ⇒ 那条 aria 串逐字符搬进这句看得见的图例（仓库没有 sr-only 那一族，也不为它新写一条藏法的类） */}
        {/* 第二把尺：写作年轮横条（同一只尺架里落下第二枚，就把它的图例也交给 .density-cap 那一档的嗓子——
            名字并进群组、声明不复制第二条，§17 那条复用类的口径，先例是 .tax-empty a,.essay-browse a）。
            ⚠️ 它必须排在 .density-cap **之后**：tools/pagination-check.mjs 第 ③ 那枚量具是拿
            `<span class="density" …>(…)<span class="density-cap">` 这一条正则抠尺身字节的，插在中间就是让那把
            已经签字的尺去读一枚新东西。环（提案那枚更"年轮"的版）留在升级位，本卡不画。〔四轮 §4-3 已落地：
            就是下面那枚 `.rings`——它仍旧排在 `.density-cap` 之后、`.yring` 一族之后，一个字节都没插进尺身里。〕 */}
        {/* 零篇可见稿 ⇒ 这把横条连同它的图例整块不落（作者把三篇都标了 draft: true 之后，产物里印过
            `NaN.NaN.NaN → NaN.NaN.NaN（0 天写过）`——那是 `Math.max()` 在空数组上的读数上了纸）。
            口径照 §12 那句"空着就是不画"，不给空盒擦亮；同页那把 12 月刻度尺不受影响（它按 `.tick.nil` 画空档）。 */}
        {posts.length > 0 && <>
        <span class="yring" aria-hidden="true">
          {ringMonths.map(g => <span class="yr-month" style={`flex:${g.days.length}`}>{g.days.map(c => c.w
            ? <span class="yr-lit" style={`background:color-mix(in srgb,var(--moss-ink) ${25 + Math.round(c.w / ringPeak * 75)}%,transparent)`}></span>
            : <span></span>)}</span>)}
        </span>
        <span class="yring-cap">写作年轮 · 每格一天 · {fmtDate(new Date(ringStartTs))} → {fmtDate(ringEnd)}（{ringWrote} 天写过）</span>
        </>}
        {/* 第三把尺：同心环归档（四轮 §4-3，上面那一格预登记的升级位）。三句话：
            ① 一圈一年、圈上的点＝那一年写过的篇数，**点数是真数**——一篇都不许画占位点（§12 禁假数字：
               多一枚点就是替作者多写一篇）。零篇可见稿与只有一年那两档由 `yearRings()` 交回 null ⇒
               **整块不落**，连同它的图例一个字节都不进产物（判据与两条理由写在那一份里，这里不重写）。
            ② 每一圈是一枚真链接：靶＝下面那一格 `.year-block` 的 `id`（本轮给它落的真 id，见那一格注释）。
               尺身 aria-hidden 那一族的口径照旧——图形自己不对读屏说话，读屏吃的是每一圈那枚链接的名字，
               精确值由下面的目录行逐行说；图例那一句只说"一圈一年、一点一篇"与"由内而外是早到晚"这两件
               **画法**，不替它编第二份读数（§12 那句"给年度弧补读数"判不进，同一条）。
            ③ 零新材质：色走 `--moss`／`--ink` 两枚在册令牌，`opacity` 档照 `.density .tick` 那三枚搬
               （.55 那一档是它的同伴，不是新值）；零 `animation`、零 `transition`、零滚动驱动 ⇒
               `prefers-reduced-motion` 那一档对它**没有可撤的东西**（不是"免疫"——它不进场、不动，
               但那两档媒体查询本来就没有点到它的份）；零 `backdrop-filter`、零半透明的"面" ⇒
               `prefers-reduced-transparency` 那份名单（本文件末尾那一格）管不着它，与 `.density` 同判。
            ⚠️ 画幅走 `em`（宿栏字高的一档），不新写一枚 px；环与列表之间那口气用的是 `.density-wrap`
               在册那枚 `gap:14px` 与 `.page-head` 在册那枚 `padding-bottom:64px` ⇒ **零枚新垂直槽位**，
               gap-check 那 144 枚一枚不多、圆角那 32 枚一枚不添（它走 SVG，`border-radius` 零枚）。 */}
        {rings && <>
        <span class="rings" role="group" aria-label="年轮目录">
          {rings.rings.map(r => <a class="ring" href={ringTo(r.y)} aria-label={`${r.y} 年 ${r.n} 篇`}>
            <svg viewBox={`0 0 ${rings.box} ${rings.box}`} aria-hidden="true" focusable="false">
              <circle class="ring-line" cx={rings.cx} cy={rings.cy} r={r.r}/>
              {r.dots.map(d => <circle class="ring-dot" cx={d.x} cy={d.y} r={rings.dot}/>)}
            </svg>
          </a>)}
        </span>
        <span class="rings-cap">同心年轮 · 一圈一年 · 一点一篇 · 由内而外是早到晚（{rings.years} 年 · {rings.posts} 篇）</span>
        </>}
      </span>
    </header>

    {/* 按年分节那一块的靶（四轮 §4-3 落的第一枚真 id）：上面那一圈一跳就落在它身上。
        ⚠️ 为什么 id 落在 `.year-block` 而不是给 `.year-mark` 那枚 `<h2>` 加：
           `tools/pagination-check.mjs` 第 ② 格拿 `<h2 class="year-mark">(\d{4})</h2>` 数节头序列，
           那行的类名与字面形状是签过字的；`<section>` 的开口字节没有尺读它（第 ④ 那格读的是 `<main>`
           的**直接子元素种类**序列，属性不在判据里），所以靶落在 section 那一层是两处真值最少的一处。
           名字 `y<YYYY>` 由年份现算，不替作者起名、不抄第二份字面量；一页里同一枚年份只可能落一枚节头
           （一年的行被页界切开时两页各写一次那一年，见上面 `byYear` 那一格）⇒ 片段不会有两枚靶抢同一枚地址。
        ⚠️ 分页那态（`ranges.length > 1`）本页只有本页那几行的年份，别的年份由 `ringTo()` 指到它自己在的那一页——
           本文件里任何一枚具名片段都在同一份产物里有靶，这是 §12 死锚点禁令的产物级版，
           由 `tools/runtime-check.mjs` 末尾那一格全站扫一遍（它只认 `href="#x"` ⇄ 同页 `id="x"`，
           跨页那种 `/essays/page/<n>/#x` 它不读，改由 `tools/ring-check.mjs` 第 ③ 格拿产物逐枚验）。 */}
    {byYear.map(g => (
      <section class="year-block reveal" id={`y${g.y}`}>
        <h2 class="year-mark">{g.y}</h2>
        {chunksOf(g).map(c => (<>
          {c.q ? <div class="q-mark">q{c.q}</div> : null}
          <ol class="essay-index" data-density={density}>
          {c.items.map(p => {
            const n = ++folio;
            const d = p.data.date;
            /* 封面那枚 `<img>` 上的 width/height/decoding 与 `src/components/PostRow.astro` 同一口径
               （属性被 `.cover img{position:absolute;inset:0}` 完全覆写 ⇒ 已签字的 92×69 一格不动；
               coverSrc() 调两次是绕开 `tools/media-check.mjs` 第 ④ 格那枚字面绊线，理由写在那一卡的注释里。
               2026-10-01 晚这一行与 PostRow 同一批从"有封面才画"改成"没填也画"——退路只有一枚函数，两处各 import 它）*/
            return (
              <li>
                <a class="row" href={`/essays/${p.id}/`} data-slug={p.id}>
                  <span class="folio">{pad(n)}</span>
                  <span class="cover"><img src={coverSrc(p.data.cover)} {...intrinsicProps(coverSrc(p.data.cover))} alt="" loading="lazy" decoding="async"></span>
                  <span class="row-main">
                    <h3>{p.data.title}</h3>
                    <p class="row-ex">{p.data.excerpt}</p>
                  </span>
                  <span class="row-side">
                    <time>{fmtDate(d).slice(5)}</time>
                    <span class="row-min">{readMinutes(p.body)} min</span>
                    {/* 每行字数尺：常显，不悬停（§8.3 那枚悬停预算已满，§1 也不开第二档"钉死的铺底"）。
                        它是上面那枚 `N min` 的图形、同一个 bodyLen 的同源两读，所以这一行不多一份真值。 */}
                    <span class="row-tick" style={`height:${tickEm(bodyLen(p.body))}em`}></span>
                  </span>
                </a>
              </li>
            );
          })}
          </ol>
        </>))}
      </section>
    ))}

    {/* 三族索引页的可见入口（F2，判它出现几次数的账在 `---` 上面那一格）：
        ⚠️ 零新 CSS 的两条落点——① 锚点吃 `mistwood.css:556` 那条 `.tax-empty a`，做法是**给名单添一枚名字**
           （`.tax-empty a,.essay-browse a`），声明仍只有一处真值（§17 复用类、不复制声明，同一份表里的先例
           是 `.cover img,.thing .shot,.portrait img,.post-body img`）；② 容器 `.essay-browse` 一条声明都不写，
           行内布局＋继承的行高 ⇒ `gap-check` 那 142 枚间距与 30 枚圆角一个都不动。
        ⚠️ 悬停吃同一条 `:hover`（`text-decoration-color` ＋ `text-decoration-thickness` 两枚属性），
           不为这一族另写一条 ⇒ §1 那枚"手势内 ≤3 属性"的预算自动守住。
        ⚠️ 为什么不能拿详情页那族 `.post-act` 当落点：这一页只加载 `Layout.*.css`（base ＋ mistwood 两份），
           `.post-act` 住在 `essay.css`，在这一页根本不存在——用它就是给这一页新引一份材质。
        三族全空 ⇒ 整块一个字节都不落（今天这一态）。 */}
    {browse.length > 0 && (
      <nav class="essay-browse" aria-label="按家族读这份目录">browse — 按 {browse.flatMap((f, i) => [i ? ' · ' : null, <a href={f.at}>{f.label}</a>])} 读</nav>
    )}

    {/* 翻页那一行：**整份名单装得下就一个字都不出现**（`ranges.length > 1` 是唯一的条件）。
        今天三篇 ÷ 每页 3 行 ＝ 一页 ⇒ 产物里既没有 `<nav>`、也没有 `/essays/page/` 这串字节，
        `/essays/` 与不分页那一档逐字节相同（§15 那一格记的实测）。这不是"藏起来"，是"这条路不存在"
        ——§12 那条"关掉之后不留活壳"在分页这一族的读法。
        零新 CSS（本轮硬口径）：宿主是 `.tax-empty`（分类/标签/系列那三页空态那句话的档，`mistwood.css:551`），
        链接吃同一份 `.tax-empty a` 的声明 ⇒ 零枚新垂直槽位、零枚新圆角字面，
        `tools/gap-check.mjs` 那 142 枚与 30 枚一个都不动；落点在最后一个 `.year-block` 之后，
        用的是它那条在册 96px 的余隙，不新起一段节奏。 */}
    {ranges.length > 1 && (
      <nav class="tax-empty" aria-label="目录翻页">目录第 {page} 页 · 共 {ranges.length} 页{page > 1 && <> · <a href={pageHref(page - 1)}>← 上一页</a></>}{page < ranges.length && <> · <a href={pageHref(page + 1)}>下一页 →</a></>}</nav>
    )}
  </main>
</Layout>
