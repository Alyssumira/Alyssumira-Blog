---
import '../styles/base.css';
import '../styles/mistwood.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Seo from '../components/Seo.astro';
import { ROOT } from '../lib/stats.js';
import { NAV } from '../lib/nav.js';
import { fonts } from '../data/site.js';
/* 「写于 / 改于」那两枚日历日在全站只有一把尺子（§13a 结构化数据那一格）：`Seo.astro` 的 JSON-LD
   `datePublished` / `dateModified` 吃的就是下面这两枚函数，head 里那两枚 `article:*` meta 现在也吃它们。
   ⚠️ 这里不许出现第二种 `getUTC*` 拼法、也不许 `revised ?? date` 那种回落——§13a:1092 把 `dateModified`
      登记成"这一格里唯一不许回落的字段"，head 那两枚 meta 与它读的是同一枚字段，回落一次就是同一件事
      在两处各说一套（页面上那行「改于」走的是 `whenLine()` → 同一个 `revisedOn`，三枚消费者一把尺子）。 */
import { publishISO, revisedOn } from '../lib/revised.js';

/* revised / date 只有详情页（src/pages/essays/[slug].astro 那个 <Layout> 标签）会传：其余五页没有 ⇒
   Seo 那一格整字段不写，不许拿别的日期顶上（§13a） */
const { title, desc = '在森林与代码之间，收集微风、光影和好文章。', here = '', tier = 'read', type = 'website', revised, date, ogCard, noindex = false } = Astro.props;
/* 不列入（第十五轮 `card/unlisted`，判据是 `src/lib/taxonomy.js` 的 `isUnlisted()`、由详情页传进来）：
   `noindex` 为真 ⇒ 下面多一行 `<meta name="robots" content="noindex">`，为假 ⇒ 一个字节都不多。
   ⚠️ **为什么是一枚 prop、条件落在这枚壳里**：这就是 §13a 那一格记过的同一招——"要收掉 404 的 canonical
      只有一行 `{tier !== 'lost' && <link …>}`"。全站只有一枚 `<head>`，所以"这一页要不要被机器收进索引"
      这件事也只许有那一处落点；在 `src/pages/essays/[slug].astro` 里另写一份 head、或再开一枚组件，
      就是给同一件事立第二套机制（§16 那一族）。默认值 `false` ⇒ **没传它的页面一个字节都不多**，
      这正是本项目那把"改前改后逐字节对账"的尺子量得动的形状。
   ⚠️ **说明不许写成模板里的 HTML 注释**：Astro 把 HTML 注释原样落进产物（`[slug].astro` 那段许可族的注释
      就是为同一件事写在 `---` 里的），写在这儿就会跟着每一页进 dist/，那枚"逐字节相同"的尺子当场破。
   ⚠️ 这一枚 meta 挡的是"被搜索引擎与抓取器顺手收走"，挡不了"知道地址的人读到"——这一族要的就是这个差别。
      §12 那条"静态站上不许宣称密码保护"记的就是这条界线：诚实的名字是**不列入**，不是"加密"。 */
/* 绝对地址：社交卡与 og:url 拿的是访客之外第三双眼睛看到的 URL，相对路径在那边不成立。
   Astro.site 现在是占位域名（§16），改了 astro.config.mjs 这两行跟着变，不另抄一份 */
const canonical = new URL(Astro.url.pathname, Astro.site);
/* 逐篇社交卡（§13a 那一格，2026-09-29）：这一页有自己那张卡就用它，没有就干净退回站点级 /og.png。
   两枚来源，一条优先级：
   ① `ogCard` prop 是正门——哪一页要指定自己的卡，传一枚站内相对路径（必须以 / 开头）。
   ② 详情页那一份模板本轮不许动（另一张卡在上面），所以 /essays/<slug>/ 这一格由**本页地址 + 盘上有没有那张图**派生。
      判据是 existsSync(public/og/<slug>.png)：public/ 整目录被原样拷进 dist/，所以"构建期看得见这枚文件"
      与"访客取不到它"这两件事不可能同时成立——盘上有就是取得到，盘上没有就是这一篇还没出图。
   ⚠️ 不许在这里出现裸域名：两枚来源都只给相对路径，绝对地址仍然只由 Astro.site 拼一份（§16 那枚开关）。
   ⚠️ 缺一张卡**不是**错：那一页退回站点级那张，与改动前逐字节相同。反过来才危险——
      把没有图的地址写进 og:image，转发出去是一片空白，那比"这张卡长得跟站点那张一样"更糟。 */
const SITE_CARD = '/og.png';
function cardFor(pathname){
  const m = /^\/essays\/([a-z0-9][a-z0-9._-]*)\/$/.exec(pathname);
  if (!m) return null;
  return existsSync(join(ROOT, 'public', 'og', `${m[1]}.png`)) ? `/og/${m[1]}.png` : null;
}
if (ogCard !== undefined && ogCard !== null && !ogCard.startsWith('/')) {
  throw new Error(`Layout.astro 的 ogCard prop 只吃站内相对路径，收到 "${ogCard}"——绝对地址一律由 Astro.site 拼一份（§16），这里不许出现第二处域名`);
}
const ogImage = new URL(ogCard || cardFor(Astro.url.pathname) || SITE_CARD, Astro.site);
/* 站名从字面量提成变量：og:site_name 与 JSON-LD 的 WebSite.name 吃同一枚值（§13a）。
   ⚠️ 只折了这两处消费——下面那条 rss 的 title、各页页题尾巴上的 ' · mistwood' 还各自写着，散在本卡不许碰的文件里 */
const SITE_NAME = 'mistwood';
/* `article:published_time` / `article:modified_time`（§13a 身份件那一格）：两枚值就是上面那条注释点名的
   那两枚函数的返回值——**不重算、不换格式、不回落**。
   `publishISO()` 交回空串（这一页没有一枚合法的日历日）与 `revisedOn()` 交回 `undefined`
   （git 问不到改动型提交，或改动那天不晚于发布那天）两种情形都落成**这一行根本不写**，
   而不是写一枚空 content、也不是拿发布日期顶上：§13a:1092 那句「`revised ?? date` 是最危险的假语境」
   管的正是这一族——机器读成"这篇后来改过"，而盘上从来没有那次改动。少一项不是错，多一项才是。
   ⚠️ 今天三篇稿子都没有改动型提交（`git log --diff-filter=M -- src/content/posts` 实测 0 行），
      所以 `article:modified_time` 在**每一份产物上都不存在**——那是正确的读数，不是漏了一行。
   ⚠️ 两枚都只在 `og:type` 为 `article` 的那几页出现：这一族说的是"这一篇文章的时间"，
      首页／目录页／404 领一枚就是假语境；这道门同时让"非文章页一枚都不许有"那一问在结构上成立。
      判据在 `tools/runtime-check.mjs` 的 **1f 段**：它对着 front matter 的 `date` 与 `git log` **独立**复算
      一遍期望值（不复用这两枚函数，否则尺子走的就是被测物自己——§13a:1092 那格立的口径），
      再与 head 那两枚 meta、JSON-LD 那两枚字段三方对账。 */
const artPub = type === 'article' ? publishISO(date) : '';
const artMod = type === 'article' ? (revisedOn(date, revised) || '') : '';
/* `og:image:alt`：alt 要说的是"这张图上写着什么"，而这张图上写的就是**两句站里本来就有的字面量**
   （§13a:1076 那一格：纯排版方案、没有用照片）。两档卡的第二行不同，alt 也跟着分两档，不许一句话糊过去：
     · 逐篇卡（`/og/<slug>.png`）＝ eyebrow 那行站名身份 ＋ 这一篇的题名（出图时注进文案槽的就是 title，
       `tools/og-check.mjs` ④ 那一格逐枚对账"清单题面 ⇄ 当前 front matter"）；
     · 站点级那张（`/og.png`）＝ 同一行站名身份 ＋ **首页 H1 那句**（`tools/og-cards.mjs` 给站点级那张传的
       题面是 null ⇒ 槽保持模板默认）。这一档 cover 的是首页／关于／notes／things／三族目录／404 那几页，
       它们的页题**根本不在卡面上**——给 `/notes/` 写"卡面写着这一页的题名「碎碎念 · mistwood」"就是谎话：
       alt 描述的是图的内容，不是这张图的用途。
   ⚠️ 题名吃页题（与 `<title>` / `og:title` / JSON-LD `headline` 同一枚值，因此也带着 ' · mistwood' 尾巴）——
      理由与 §13a 那格 `headline` 那笔账一字不差：同一篇稿子两份题名迟早对不上，宁可带尾巴，不多一处出处。
   ⚠️ 站点级那一档**故意不把那句 H1 抄进这份文件**：它在 `src/pages/index.astro` 的 H1 与
      `tools/og-card.html` 的文案槽默认值里已经各有一份，抄进来就是第三处字面量（§13a"一处真值"）。
   ⚠️ 判档用 `ogImage.pathname === SITE_CARD`，吃的是上面那枚常量，不在这里重抄第三遍 `/og.png`。 */
const ogImageAlt = ogImage.pathname === SITE_CARD
  ? `${SITE_NAME} 的社交卡（纯排版、没有照片）：卡面写着站名与首页那句标题`
  : `${SITE_NAME} 的社交卡（纯排版、没有照片）：卡面写着站名与这一篇的题名 ${title}`;
/* 导航表本体在 `src/lib/nav.js`（第六轮 `card/navcrumb` 搬出去的）：这一枚壳画它，`Seo.astro` 的
   JSON-LD 面包屑与详情页那行可见面包屑吃同一份。这里不再写字面量——写第二份就是给"哪一栏叫什么"
   立两处真值（§13a 那格的原话是"抄的那份改了没人知道"，本轮只是把同一个理由管到屏幕上那条链）。
   ⚠️ 项数一枚没动：胶囊那一排仍旧是 5 链接 + 滑杆 + 主题 = 七项，§11 那笔 296.48／上限 300 的实测账
   由 `tools/search-check.mjs` 在 gate 里数着，本轮不给它添第八项。 */
/* css2 URL 从今天起不拼了（2026-09-30 `card/cjk-subset`：四族全自托管——拉丁两族见 base.css「自托管」节与
   tools/font-selfhost.*，CJK 两族是子集，见 tools/font-subset.*）。牙留着：fonts[] 里哪条丢了 `self` 旗，
   在这版 Layout 里就变成"档案列了它、但任何页面都不会载入它"——当场抛，不静默缺一族。 */
if (fonts.some(f => !f.self)) throw new Error(`fonts 清单里这些族没有 self 旗：${fonts.filter(f => !f.self).map(f => f.name).join(' / ')}——Layout 已不拼 css2 URL，它们不会在任何页面载入。要么把自托管补齐（表进 base.css、文件进 public/fonts/**、清单在册），要么把上一版 Layout 的 css2 拼装与 preconnect 原样恢复回来，二选一，别静默。`);
---
<!DOCTYPE html>
<html lang="zh-CN" data-theme="light" data-phase="day" data-tier={tier}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={desc}>
<!-- 身份件（§13a）：林线两版按系统外观分文件，不靠 SVG 里的 @media——那条在部分浏览器只在载入时算一次。
     系统外壳的颜色归系统管，和站内那枚日/月开关是两件事，所以这里不读 localStorage。
     theme-color 只写亮色一档：无 JS 时 <html data-theme> 本来就是 light，写两版反而在骗无脚本的访客。
     真切成夜林时由下面那段内联脚本改它（首帧之前），点开关时 site.js 再改一次 -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" media="(prefers-color-scheme: light)">
<link rel="icon" href="/favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#F2F4EF">
<meta property="og:type" content={type}>
<meta property="og:site_name" content={SITE_NAME}>
<meta property="og:locale" content="zh_CN">
<meta property="og:url" content={canonical.href}>
<!-- 规范链接：trailingSlash 是 'ignore'（astro.config.mjs:77），同一篇稿子的 /essays/foo 与 /essays/foo/ 各自回 200，
     等于给搜索引擎留了两枚地址却没有一句话说明哪一枚是那一本——这一枚就是那句话。
     值就是上面那个 URL 对象，不在这里再算第二个，也不许往别处抄第三份绝对地址（同一页只许一个真值，§16） -->
<link rel="canonical" href={canonical.href}>
{noindex && <meta name="robots" content="noindex">}
<meta property="og:title" content={title}>
<meta property="og:description" content={desc}>
<meta property="og:image" content={ogImage.href}>
<meta property="og:image:alt" content={ogImageAlt}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{/* 文章的时间戳（§13a 身份件那一格）：两枚值来自 `src/lib/revised.js` 里 JSON-LD 已经在用的那两枚函数，
    拿不到 ⇒ 这一行不写（`artPub` / `artMod` 是空串，条件节点整个短路，一个字节都不落进产物）。
    ⚠️ 这一段是 Astro 的模板注释、不是 HTML 注释——后者会原样跟着每一页进 dist/，
       "改前改后逐字节对账"那把尺子当场破（口径与上面那枚 Atom 宣告那一段同一条）。 */}
{artPub && <meta property="article:published_time" content={artPub}>}
{artMod && <meta property="article:modified_time" content={artMod}>}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={desc}>
<meta name="twitter:image" content={ogImage.href}>
<!-- 结构化数据（§13a）：一份 JSON-LD，站点身份 + 详情页那一篇 + 面包屑。它是构建期落的静态 HTML，
     没有内联脚本、不碰首帧那五枚显示属性的判定（下面那段是全站唯一的内联写者，理由钉在 §16 第四类门禁） -->
<Seo siteName={SITE_NAME} canonical={canonical} ogImage={ogImage} title={title} desc={desc} type={type} here={here} revised={revised} date={date} />
<link rel="alternate" type="application/rss+xml" title="mistwood" href="/rss.xml">
{/* 机器那一路的订阅宣告（§20 F1 的姊妹格）：站建了两份 feed——`dist/rss.xml` 与 `dist/atom.xml`
     吃的是同一枚 `visiblePosts()`——可 head 从前只宣告 rss，于是 Atom 那一份**在盘上、阅读器却发现不了它**。
     ⚠️ 这一枚不是屏幕上那行字：§20 裁的"不给 Atom 并列第二枚"管的是首页 `.hero-log` 里那枚**可见入口**
     （并排两枚字递给读者的不是两份内容，是同一份清单的两副地址），这一枚是 `<head>` 里给机器读的宣告；
     两者不冲突，这一行也没有推翻那一条裁决——那句话的分界就画在这里。
     `href` 只许站内相对：绝对地址的唯一出处是 `astro.config.mjs` 的 SITE（§13a 身份件一处真值）。
     `title` 与上面那枚同值——同一族的两副地址读起来必须像一份身份。
     牙在 `tools/runtime-check.mjs` 的 1e 段（每页各恰一枚 ⇄ 两枚 feed 文档真在盘上 ⇄ 没有一枚
     `rel="alternate"` 指向不存在的文件）。这一段是模板注释（不是 HTML 注释），一个字节都不落进产物。 */}
<link rel="alternate" type="application/atom+xml" title="mistwood" href="/atom.xml">
<!-- 原生预取（零 JS）：把目标文档在悬停时就备好，跨页转场（§8.3）才不会因为新文档还没加载完
     而退化成瞬时导航。conservative = 有真实交互意图才预取，不会一进来就把五个页面全拉下来 -->
<script type="speculationrules" is:inline>
{"prerender":[{"where":{"href_matches":["/*"]},"eagerness":"conservative"}]}
</script>
<script is:inline>
(function(){try{var t=localStorage.getItem('mistwood-theme');if(!t)t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',t);var m=document.querySelector('meta[name="theme-color"]');if(m&&t==='dark')m.setAttribute('content','#0E130D');}catch(e){}})();
/* 显示偏好先落地再首帧：雾和颗粒是"看得见的面"，等模块脚本跑完再改会闪一下 */
(function(){var r=document.documentElement,d={};try{d=JSON.parse(localStorage.getItem('mistwood-display'))||{};}catch(e){}
 var enter=d.enter||'auto';r.setAttribute('data-fog',d.fog||'normal');r.setAttribute('data-grain',d.grain||'on');r.setAttribute('data-fireflies',d.fireflies||'on');r.setAttribute('data-enter',enter);
 /* 回访判定必须在首帧之前：晚一步照片已经开始 2.2s 的淡入，改了也看不见。
    判据是"本次会话里已经播过一次入场"（sessionStorage＝标签页级），不是载入次数——
    站内跳转也算一次的 mistwood-opens 分不清"刚进来"和"翻了个页"。用户点了"每次完整"就不走这条捷径。 */
 try{
  if(enter==='auto'&&sessionStorage.getItem('mistwood-seen'))r.setAttribute('data-revisit','1');
  sessionStorage.setItem('mistwood-seen','1');
 }catch(e){}   /* 隐私模式下 sessionStorage 会抛：读不到就当第一次，慢慢播一遍 */
})();
</script>
</head>
<body>

<div class="grain" aria-hidden="true"></div>

<header class="nav">
  <div class="nav-clock">
    <!-- 一枚点两层信息：实心点是"现在"，外面那圈弧是"今天已经走完的这一段"（§6）。
         弧占位靠 overflow 画出 5px 盒子之外，不改一行版面；起点在 12 点方向，顺时针走一圈＝24h -->
    <span class="nowdot"><span class="dot"></span><svg class="dayring" viewBox="0 0 15 15" aria-hidden="true"><circle id="day-ring" cx="7.5" cy="7.5" r="7" transform="rotate(-90 7.5 7.5)"/></svg></span>
    <span id="clock">--:--</span>
    <span>·</span>
    <span>mistwood</span>
    <span class="weather">· <span id="weather-word">light</span></span>
  </div>
  <nav class="nav-links">
    {NAV.map(([href, label, key]) => <a href={href} class:list={[{ here: key === here }]}>{label}</a>)}
    <div class="display">
      <button class="settings-toggle" id="settings-toggle" aria-expanded="false" aria-controls="display-settings" aria-label="显示设置" title="显示设置">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h10M18 7h2M4 17h4M12 17h8"/>
          <circle cx="16" cy="7" r="2.2"/><circle cx="10" cy="17" r="2.2"/>
        </svg>
      </button>
      <!-- 收起态：CSS 里 visibility:hidden 让它退出可读树，JS 再补一层 inert，两者同向 -->
      <div class="settings" id="display-settings" inert>
        <p class="settings-cap">显示设置</p>
        <div class="seg" role="group" aria-label="雾浓度">
          <span class="seg-k">雾</span>
          <span class="seg-opts">
            <label><input type="radio" name="fog" value="thin"><span class="seg-c">淡</span></label>
            <label><input type="radio" name="fog" value="normal"><span class="seg-c">中</span></label>
            <label><input type="radio" name="fog" value="thick"><span class="seg-c">浓</span></label>
          </span>
        </div>
        <div class="seg" role="group" aria-label="胶片颗粒">
          <span class="seg-k">颗粒</span>
          <span class="seg-opts">
            <label><input type="radio" name="grain" value="on"><span class="seg-c">有</span></label>
            <label><input type="radio" name="grain" value="off"><span class="seg-c">无</span></label>
          </span>
        </div>
        <div class="seg" role="group" aria-label="萤火虫">
          <span class="seg-k">萤火</span>
          <span class="seg-opts">
            <label><input type="radio" name="fireflies" value="on"><span class="seg-c">有</span></label>
            <label><input type="radio" name="fireflies" value="off"><span class="seg-c">无</span></label>
          </span>
        </div>
        <!-- 第四枚旋钮管的是"第几次进场"：默认按会话走简版，点"每次完整"就永远慢慢播一遍（§8.2） -->
        <div class="seg" role="group" aria-label="入场">
          <span class="seg-k">入场</span>
          <span class="seg-opts">
            <label><input type="radio" name="enter" value="auto"><span class="seg-c">自动</span></label>
            <label><input type="radio" name="enter" value="full"><span class="seg-c">完整</span></label>
          </span>
        </div>
      </div>
    </div>
    <!-- ⚠️ 导航里**没有**第三枚按钮（第十一轮 `card/search` 的裁决，账在 §11 那一整行里）：
         `.nav-links` 在 ≤340 档实测 270.48px，胶囊需要 296.48 而那一档的上限解析成 300 ⇒ 余量 3.52px，
         再加一枚 30px 圆钮 + 一枚 gap 任何一档都装不下。搜索入口因此改挂在**内容页扉页那一行**
         （`src/components/SearchEntry.astro`，六份子页的 `.sec-label` 行 + 首页 `.hero-log` 那一行），
         代价照实登记在 §11 与 §9：访客只能在子页扉页找到它，导航里找不到。
         这一排的项数本轮**未变**（5 链接 + 滑杆 + 主题 = 七项），296.48 那笔账一个字不动。 -->
    <button class="theme-toggle" id="theme-toggle" aria-label="切换主题">
      <svg id="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
      </svg>
      <svg id="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none">
        <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/>
      </svg>
    </button>
  </nav>
</header>

<slot />

</body>
