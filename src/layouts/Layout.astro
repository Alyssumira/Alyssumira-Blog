---
import '../styles/base.css';
import '../styles/mistwood.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Seo from '../components/Seo.astro';
import { ROOT } from '../lib/stats.js';
import { fonts, FONT_HOST, FONT_FILE_HOST } from '../data/site.js';

/* revised / date 只有详情页（src/pages/essays/[slug].astro 那个 <Layout> 标签）会传：其余五页没有 ⇒
   Seo 那一格整字段不写，不许拿别的日期顶上（§13a） */
const { title, desc = '在森林与代码之间，收集微风、光影和好文章。', here = '', tier = 'read', type = 'website', revised, date, ogCard } = Astro.props;
/* 绝对地址：社交卡与 og:url 拿的是访客之外第三双眼睛看到的 URL，相对路径在那边不成立。
   Astro.site 现在是占位域名（§16），改了 astro.config.mjs 这两行跟着变，不另抄一份 */
const canonical = new URL(Astro.url.pathname, Astro.site);
/* 逐篇社交卡（§13a 那一格，2026-09-29）：这一页有自己那张卡就用它，没有就干净退回站点级 /og.png。
   两枚来源，一条优先级：
   ① `ogCard` prop 是正门——哪一页要指定自己的卡，传一枚站内相对路径（必须以 / 开头）。
   ② 详情页那一份模板本轮不许动（另一张卡在上面），所以 /essays/<slug>/ 这一格由**本页地址 + 盘上有没有那张图**派生。
      判据是 existsSync(public/og/<slug>.png)：public/ 整目录被原样拷进 dist/，所以"构建期看得见这枚文件"
      与"访客取不到它"这两件事不可能同时成立——盘上有就是取得到，盘上没有就是这一篇还没出图。
   ⚠️ 不许在这里出现裸域名：两枚来源都只给相对路径，绝对地址仍然只由 Astro.site 拼一份（§16 那枚开关）。
   ⚠️ 缺一张卡**不是**错：那一页退回站点级那张，与改动前逐字节相同。反过来才危险——
      把没有图的地址写进 og:image，转发出去是一片空白，那比"这张卡长得跟站点那张一样"更糟。 */
const SITE_CARD = '/og.png';
function cardFor(pathname){
  const m = /^\/essays\/([a-z0-9][a-z0-9._-]*)\/$/.exec(pathname);
  if (!m) return null;
  return existsSync(join(ROOT, 'public', 'og', `${m[1]}.png`)) ? `/og/${m[1]}.png` : null;
}
if (ogCard !== undefined && ogCard !== null && !ogCard.startsWith('/')) {
  throw new Error(`Layout.astro 的 ogCard prop 只吃站内相对路径，收到 "${ogCard}"——绝对地址一律由 Astro.site 拼一份（§16），这里不许出现第二处域名`);
}
const ogImage = new URL(ogCard || cardFor(Astro.url.pathname) || SITE_CARD, Astro.site);
/* 站名从字面量提成变量：og:site_name 与 JSON-LD 的 WebSite.name 吃同一枚值（§13a）。
   ⚠️ 只折了这两处消费——下面那条 rss 的 title、各页页题尾巴上的 ' · mistwood' 还各自写着，散在本卡不许碰的文件里 */
const SITE_NAME = 'mistwood';
const links = [
  ['/', '首页', 'home'],
  ['/essays/', '文章', 'essays'],
  ['/things/', '小东西', 'things'],
  ['/about/', '关于', 'about'],
  ['/notes/', 'notes', 'notes'],
];
/* css2 只拼没自托管旗的族（见 src/data/site.js 的 fonts 清单与 base.css 的自托管节）；
   哪一天四族全解绑了，这一枚就该整行拆掉而不是发一个空查询——当场抛，不静默挂一枚坏 link */
const remoteFonts = fonts.filter(f => !f.self);
if (!remoteFonts.length) throw new Error('fonts 清单里没有远程族了，但 Layout 还在拼 css2 URL——全自托管那天应删掉这枚 <link>，而不是发空查询');
const FONTS = `${FONT_HOST}/css2?${remoteFonts.map(f => 'family=' + f.q).join('&')}&display=swap`;
---
<!DOCTYPE html>
<html lang="zh-CN" data-theme="light" data-phase="day" data-tier={tier}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={desc}>
<!-- 身份件（§13a）：林线两版按系统外观分文件，不靠 SVG 里的 @media——那条在部分浏览器只在载入时算一次。
     系统外壳的颜色归系统管，和站内那枚日/月开关是两件事，所以这里不读 localStorage。
     theme-color 只写亮色一档：无 JS 时 <html data-theme> 本来就是 light，写两版反而在骗无脚本的访客。
     真切成夜林时由下面那段内联脚本改它（首帧之前），点开关时 site.js 再改一次 -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" media="(prefers-color-scheme: light)">
<link rel="icon" href="/favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#F2F4EF">
<meta property="og:type" content={type}>
<meta property="og:site_name" content={SITE_NAME}>
<meta property="og:locale" content="zh_CN">
<meta property="og:url" content={canonical.href}>
<!-- 规范链接：trailingSlash 是 'ignore'（astro.config.mjs:11），同一篇稿子的 /essays/foo 与 /essays/foo/ 各自回 200，
     等于给搜索引擎留了两枚地址却没有一句话说明哪一枚是那一本——这一枚就是那句话。
     值就是上面那个 URL 对象，不在这里再算第二个，也不许往别处抄第三份绝对地址（同一页只许一个真值，§16） -->
<link rel="canonical" href={canonical.href}>
<meta property="og:title" content={title}>
<meta property="og:description" content={desc}>
<meta property="og:image" content={ogImage.href}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={desc}>
<meta name="twitter:image" content={ogImage.href}>
<!-- 结构化数据（§13a）：一份 JSON-LD，站点身份 + 详情页那一篇 + 面包屑。它是构建期落的静态 HTML，
     没有内联脚本、不碰首帧那五枚显示属性的判定（下面那段是全站唯一的内联写者，理由钉在 §16 第四类门禁） -->
<Seo siteName={SITE_NAME} canonical={canonical} ogImage={ogImage} title={title} desc={desc} type={type} here={here} links={links} revised={revised} date={date} />
<link rel="preconnect" href={FONT_HOST}>
<link rel="preconnect" href={FONT_FILE_HOST} crossorigin>
<link href={FONTS} rel="stylesheet">
<link rel="alternate" type="application/rss+xml" title="mistwood" href="/rss.xml">
<!-- 原生预取（零 JS）：把目标文档在悬停时就备好，跨页转场（§8.3）才不会因为新文档还没加载完
     而退化成瞬时导航。conservative = 有真实交互意图才预取，不会一进来就把五个页面全拉下来 -->
<script type="speculationrules" is:inline>
{"prerender":[{"where":{"href_matches":["/*"]},"eagerness":"conservative"}]}
</script>
<script is:inline>
(function(){try{var t=localStorage.getItem('mistwood-theme');if(!t)t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',t);var m=document.querySelector('meta[name="theme-color"]');if(m&&t==='dark')m.setAttribute('content','#0E130D');}catch(e){}})();
/* 显示偏好先落地再首帧：雾和颗粒是"看得见的面"，等模块脚本跑完再改会闪一下 */
(function(){var r=document.documentElement,d={};try{d=JSON.parse(localStorage.getItem('mistwood-display'))||{};}catch(e){}
 var enter=d.enter||'auto';r.setAttribute('data-fog',d.fog||'normal');r.setAttribute('data-grain',d.grain||'on');r.setAttribute('data-fireflies',d.fireflies||'on');r.setAttribute('data-enter',enter);
 /* 回访判定必须在首帧之前：晚一步照片已经开始 2.2s 的淡入，改了也看不见。
    判据是"本次会话里已经播过一次入场"（sessionStorage＝标签页级），不是载入次数——
    站内跳转也算一次的 mistwood-opens 分不清"刚进来"和"翻了个页"。用户点了"每次完整"就不走这条捷径。 */
 try{
  if(enter==='auto'&&sessionStorage.getItem('mistwood-seen'))r.setAttribute('data-revisit','1');
  sessionStorage.setItem('mistwood-seen','1');
 }catch(e){}   /* 隐私模式下 sessionStorage 会抛：读不到就当第一次，慢慢播一遍 */
})();
</script>
</head>
<body>

<div class="grain" aria-hidden="true"></div>

<header class="nav">
  <div class="nav-clock">
    <!-- 一枚点两层信息：实心点是"现在"，外面那圈弧是"今天已经走完的这一段"（§6）。
         弧占位靠 overflow 画出 5px 盒子之外，不改一行版面；起点在 12 点方向，顺时针走一圈＝24h -->
    <span class="nowdot"><span class="dot"></span><svg class="dayring" viewBox="0 0 15 15" aria-hidden="true"><circle id="day-ring" cx="7.5" cy="7.5" r="7" transform="rotate(-90 7.5 7.5)"/></svg></span>
    <span id="clock">--:--</span>
    <span>·</span>
    <span>mistwood</span>
    <span class="weather">· <span id="weather-word">light</span></span>
  </div>
  <nav class="nav-links">
    {links.map(([href, label, key]) => <a href={href} class:list={[{ here: key === here }]}>{label}</a>)}
    <div class="display">
      <button class="settings-toggle" id="settings-toggle" aria-expanded="false" aria-controls="display-settings" aria-label="显示设置" title="显示设置">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h10M18 7h2M4 17h4M12 17h8"/>
          <circle cx="16" cy="7" r="2.2"/><circle cx="10" cy="17" r="2.2"/>
        </svg>
      </button>
      <!-- 收起态：CSS 里 visibility:hidden 让它退出可读树，JS 再补一层 inert，两者同向 -->
      <div class="settings" id="display-settings" inert>
        <p class="settings-cap">显示设置</p>
        <div class="seg" role="group" aria-label="雾浓度">
          <span class="seg-k">雾</span>
          <span class="seg-opts">
            <label><input type="radio" name="fog" value="thin"><span class="seg-c">淡</span></label>
            <label><input type="radio" name="fog" value="normal"><span class="seg-c">中</span></label>
            <label><input type="radio" name="fog" value="thick"><span class="seg-c">浓</span></label>
          </span>
        </div>
        <div class="seg" role="group" aria-label="胶片颗粒">
          <span class="seg-k">颗粒</span>
          <span class="seg-opts">
            <label><input type="radio" name="grain" value="on"><span class="seg-c">有</span></label>
            <label><input type="radio" name="grain" value="off"><span class="seg-c">无</span></label>
          </span>
        </div>
        <div class="seg" role="group" aria-label="萤火虫">
          <span class="seg-k">萤火</span>
          <span class="seg-opts">
            <label><input type="radio" name="fireflies" value="on"><span class="seg-c">有</span></label>
            <label><input type="radio" name="fireflies" value="off"><span class="seg-c">无</span></label>
          </span>
        </div>
        <!-- 第四枚旋钮管的是"第几次进场"：默认按会话走简版，点"每次完整"就永远慢慢播一遍（§8.2） -->
        <div class="seg" role="group" aria-label="入场">
          <span class="seg-k">入场</span>
          <span class="seg-opts">
            <label><input type="radio" name="enter" value="auto"><span class="seg-c">自动</span></label>
            <label><input type="radio" name="enter" value="full"><span class="seg-c">完整</span></label>
          </span>
        </div>
      </div>
    </div>
    <!-- 站内搜索：入口与面板整块带 hidden —— 没有脚本就没有这一格，理由钉在 §9 新立的那枚
         在册组件条目里（与 `[slug].astro` 那枚 `hidden` 的 post-focus、404 那枚纯 JS 的 li 同族）。
         ⚠️ 它坐在 .display 与 .theme-toggle 之间、而不是胶囊最右端：面板靠 right:0 挂在自身那枚钮的
         右缘下，放在最右就会顶到视口右边；夹在中间时它离右边天然留着一枚主题钮的宽度。 -->
    <div class="search" id="search" hidden>
      <button class="search-toggle" id="search-toggle" type="button"
              aria-expanded="false" aria-controls="search-panel" aria-label="搜索" title="搜索">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.4 15.4 21 21"/>
        </svg>
      </button>
      <!-- 收起态同 .settings：CSS 的 visibility:hidden 退出可读树 + DOM 的 inert 挡住交互与聚焦，两边同向。
           ⚠️ 这一枚 `class` 是两枚：`settings` 是抽屉那份材质的**唯一真值**（玻璃面 / 236px / 内垫 /
           错落那一族 / 打印档撤掉它的那一行），`search-panel` 只管这一格自己的三件与窄屏那一档。
           面板规则全部写成 `.settings.search-panel` 才压得过抽屉那份——顺序与权重都算过，见 base.css 那段。 -->
      <div class="settings search-panel" id="search-panel" role="dialog" aria-label="站内搜索" inert>
        <p class="settings-cap" id="search-cap">站内搜索</p>
        <input class="search-input" id="search-input" type="search" placeholder="标题 / 摘要 / 正文"
               autocomplete="off" spellcheck="false" maxlength="64" aria-labelledby="search-cap" aria-describedby="search-hint">
        <div class="search-box">
          <p class="search-hint" id="search-hint" aria-live="polite"></p>
          <ul class="search-results" id="search-results"></ul>
        </div>
      </div>
    </div>
    <button class="theme-toggle" id="theme-toggle" aria-label="切换主题">
      <svg id="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
      </svg>
      <svg id="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none">
        <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/>
      </svg>
    </button>
  </nav>
</header>

<slot />

</body>
</html>
<script>
  import '../scripts/site.js';
</script>
